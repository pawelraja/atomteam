---
// Newsletter sign-up (in the plum footer). The provider is chosen at build time (src/lib/newsletter.ts):
// MailerLite's embedded-form endpoint, any JSON endpoint, or neither (a friendly "opens soon").
// Works without JavaScript (a plain POST); with it, the result is shown in place as plain text.
// Spam: a hidden honeypot field and a short cooldown between attempts; no CAPTCHA.
import { anchor } from '../lib/anchors';
import { getData } from '../lib/data';
import { copy, fill, type Lang } from '../lib/i18n';
import { NEWSLETTER_COOLDOWN_S, newsletterConfig } from '../lib/newsletter';
import { route } from '../lib/routes';

interface Props {
  lang: Lang;
  /** Id of the heading that names the form. */
  labelledby: string;
}
const { lang, labelledby } = Astro.props;
const { site } = getData();
const t = copy(lang);
const tn = t.newsletter;
const season = site.currentSeason;
const provider = newsletterConfig();
const messages = {
  sending: tn.sending,
  success: fill(tn.success, { season }, lang),
  errorEmail: tn.errorEmail,
  errorConsent: tn.errorConsent,
  errorNetwork: fill(tn.errorNetwork, { email: t.team.email }, lang),
  errorNotLive: fill(tn.errorNotLive, { email: t.team.email }, lang),
  errorTooFast: tn.errorTooFast,
};
---

<form
  class="newsletter"
  id={anchor(lang, 'newsletter')}
  action={provider.action ?? undefined}
  method="post"
  novalidate
  data-newsletter
  data-mode={provider.mode}
  data-endpoint={provider.action ?? ''}
  data-cooldown={NEWSLETTER_COOLDOWN_S}
  aria-labelledby={labelledby}
>
  <input type="hidden" name={provider.langField} value={lang} />
  {provider.mode === 'mailerlite' && <input type="hidden" name="ml-submit" value="1" />}
  {provider.mode === 'mailerlite' && <input type="hidden" name="anticsrf" value="true" />}
  <label for="nl-email" class="newsletter__label">{tn.emailLabel}</label>
  <div class="newsletter__row">
    <input
      id="nl-email"
      name={provider.emailField}
      type="email"
      autocomplete="email"
      required
      aria-describedby="nl-email-error"
      placeholder={tn.placeholder}
    />
    <button class="btn btn--primary" type="submit">{tn.submit}</button>
  </div>
  <p class="field__error" id="nl-email-error" hidden>{tn.errorEmail}</p>
  <div class="check">
    <input id="nl-consent" name="consent" type="checkbox" value="yes" required aria-describedby="nl-consent-error" />
    <label for="nl-consent">
      {tn.consent}{' '}
      <a href={route(lang, 'privacy')}>{tn.consentPrivacy}</a>
    </label>
  </div>
  <p class="field__error" id="nl-consent-error" hidden>{tn.errorConsent}</p>
  <div class="hp" aria-hidden="true">
    <label for="nl-website">{tn.honeypot}</label>
    <input id="nl-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <p class="newsletter__status" role="status" aria-live="polite" data-status></p>
  <script type="application/json" id="newsletter-copy" set:html={JSON.stringify(messages)} />
</form>

<script>
  import { readJSON } from '../lib/client';

  type Msg = Record<'sending' | 'success' | 'errorEmail' | 'errorConsent' | 'errorNetwork' | 'errorNotLive' | 'errorTooFast', string>;
  const form = document.querySelector<HTMLFormElement>('[data-newsletter]');
  if (form) {
    const m = readJSON<Msg>('newsletter-copy');
    const email = form.querySelector<HTMLInputElement>('#nl-email')!;
    const consent = form.querySelector<HTMLInputElement>('#nl-consent')!;
    const honeypot = form.querySelector<HTMLInputElement>('#nl-website')!;
    const emailErr = form.querySelector<HTMLElement>('#nl-email-error')!;
    const consentErr = form.querySelector<HTMLElement>('#nl-consent-error')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const cooldownMs = Number(form.dataset.cooldown ?? 30) * 1000;
    const setState = (kind: 'idle' | 'sending' | 'success' | 'error', text = '') => {
      form.dataset.state = kind;
      status.textContent = text;
    };
    const showError = (input: HTMLInputElement, err: HTMLElement, bad: boolean) => {
      err.hidden = !bad;
      input.setAttribute('aria-invalid', String(bad));
    };
    // Per-visitor cooldown; storage may be unavailable (private mode), then there is none.
    const lastTry = () => {
      try {
        return Number(sessionStorage.getItem('nl-last') ?? 0);
      } catch {
        return 0;
      }
    };
    const markTry = () => {
      try {
        sessionStorage.setItem('nl-last', String(Date.now()));
      } catch {
        /* ignore */
      }
    };

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const badEmail = !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim());
      const badConsent = !consent.checked;
      showError(email, emailErr, badEmail);
      showError(consent, consentErr, badConsent);
      if (badEmail) return email.focus();
      if (badConsent) return consent.focus();

      // A filled honeypot means a bot: look successful, send nothing.
      if (honeypot.value) {
        form.reset();
        return setState('success', m.success);
      }
      const mode = form.dataset.mode;
      const endpoint = form.dataset.endpoint;
      if (mode === 'off' || !endpoint) return setState('error', m.errorNotLive);
      if (Date.now() - lastTry() < cooldownMs) return setState('error', m.errorTooFast);
      markTry();

      setState('sending', m.sending);
      button.disabled = true;
      try {
        let ok: boolean;
        if (mode === 'mailerlite') {
          const body = new URLSearchParams();
          for (const [k, v] of new FormData(form)) if (k !== 'website' && k !== 'consent') body.append(k, String(v));
          const res = await fetch(endpoint, { method: 'POST', body });
          const json = (await res.json().catch(() => ({}))) as { success?: boolean };
          ok = res.ok && json.success !== false;
        } else {
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: email.value.trim(), consent: true, lang: document.documentElement.lang }),
          });
          ok = res.ok;
        }
        if (!ok) throw new Error('rejected');
        form.reset();
        setState('success', m.success);
      } catch {
        setState('error', m.errorNetwork);
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  /* Honeypot: off-screen for people, still in the form for bots. */
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .newsletter {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .newsletter__label {
    font-size: 14px;
    color: var(--ink);
  }
  .newsletter__row {
    display: flex;
    gap: 8px;
  }
  /* Inputs on plum: #908a8e border (5.5:1); #605c5f would fail at 2.8:1. */
  input[type='email'] {
    flex-grow: 1;
    min-width: 0;
    height: 48px;
    padding: 0 18px;
    border: 1px solid #908a8e;
    border-radius: var(--r-pill);
    background: var(--surface-alt);
    color: var(--ink);
    font: 400 15px / 1.4 var(--font);
  }
  input[type='email']::placeholder {
    color: var(--ink-muted);
    opacity: 1;
  }
  input[aria-invalid='true'] {
    border-color: #ffb3c8;
  }
  .newsletter button {
    flex: none;
    min-height: 48px;
    padding: 0 24px;
    font-size: 15px;
  }
  .check {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 8px;
    align-items: start;
    font-size: 14px;
    color: var(--ink-muted);
  }
  .check input {
    width: 20px;
    height: 20px;
    margin: 0;
    accent-color: var(--accent);
  }
  .check a {
    color: var(--ink);
  }
  .field__error {
    color: #ffb3c8;
    font-size: 14px;
    font-weight: 700;
  }
  .field__error[hidden] {
    display: none;
  }
  .newsletter__status:empty {
    display: none;
  }
  .newsletter__status {
    padding: 12px 16px;
    border-radius: var(--r-sm);
    font-size: 14px;
    font-weight: 700;
  }
  .newsletter[data-state='success'] .newsletter__status {
    background: #e6f4ea;
    color: #0b5a23;
  }
  .newsletter[data-state='error'] .newsletter__status {
    background: #fde8ec;
    color: #8a0019;
  }
  .newsletter[data-state='sending'] .newsletter__status {
    background: var(--surface-alt);
    color: var(--ink-muted);
  }
  @media (max-width: 479px) {
    .newsletter__row {
      flex-direction: column;
    }
  }
</style>
