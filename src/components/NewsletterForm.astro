---
// Newsletter sign-up (in the plum footer). Not wired to a provider: set NEWSLETTER_ENDPOINT at
// build time and it POSTs JSON { email, consent, lang } there. Without it, submitting shows a
// friendly note with the team's address.
import { anchor } from '../lib/anchors';
import { getData } from '../lib/data';
import { copy, fill, type Lang } from '../lib/i18n';
import { route } from '../lib/routes';

interface Props {
  lang: Lang;
  /** Id of the heading that names the form. */
  labelledby: string;
}
const { lang, labelledby } = Astro.props;
const { site } = getData();
const t = copy(lang);
const tn = t.newsletter;
const season = site.currentSeason;
const endpoint = import.meta.env.NEWSLETTER_ENDPOINT || process.env.NEWSLETTER_ENDPOINT || '';
const messages = {
  sending: tn.sending,
  success: fill(tn.success, { season }, lang),
  errorEmail: tn.errorEmail,
  errorConsent: tn.errorConsent,
  errorNetwork: fill(tn.errorNetwork, { email: t.team.email }, lang),
  errorNotLive: fill(tn.errorNotLive, { email: t.team.email }, lang),
};
---

<form
  class="newsletter"
  id={anchor(lang, 'newsletter')}
  action={endpoint || undefined}
  method="post"
  novalidate
  data-newsletter
  data-endpoint={endpoint}
  aria-labelledby={labelledby}
>
  <input type="hidden" name="lang" value={lang} />
  <label for="nl-email" class="newsletter__label">{tn.emailLabel}</label>
  <div class="newsletter__row">
    <input
      id="nl-email"
      name="email"
      type="email"
      autocomplete="email"
      required
      aria-describedby="nl-email-error"
      placeholder={tn.placeholder}
    />
    <button class="btn btn--primary" type="submit">{tn.submit}</button>
  </div>
  <p class="field__error" id="nl-email-error" hidden>{tn.errorEmail}</p>
  <div class="check">
    <input id="nl-consent" name="consent" type="checkbox" value="yes" required aria-describedby="nl-consent-error" />
    <label for="nl-consent">
      {tn.consent}{' '}
      <a href={route(lang, 'privacy')}>{tn.consentPrivacy}</a>
    </label>
  </div>
  <p class="field__error" id="nl-consent-error" hidden>{tn.errorConsent}</p>
  <p class="newsletter__status" role="status" aria-live="polite" data-status></p>
  <script type="application/json" id="newsletter-copy" set:html={JSON.stringify(messages)} />
</form>

<script>
  import { readJSON } from '../lib/client';

  type Msg = Record<'sending' | 'success' | 'errorEmail' | 'errorConsent' | 'errorNetwork' | 'errorNotLive', string>;
  const form = document.querySelector<HTMLFormElement>('[data-newsletter]');
  if (form) {
    const m = readJSON<Msg>('newsletter-copy');
    const email = form.querySelector<HTMLInputElement>('#nl-email')!;
    const consent = form.querySelector<HTMLInputElement>('#nl-consent')!;
    const emailErr = form.querySelector<HTMLElement>('#nl-email-error')!;
    const consentErr = form.querySelector<HTMLElement>('#nl-consent-error')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const setState = (kind: 'idle' | 'sending' | 'success' | 'error', text = '') => {
      form.dataset.state = kind;
      status.textContent = text;
    };
    const showError = (input: HTMLInputElement, err: HTMLElement, bad: boolean) => {
      err.hidden = !bad;
      input.setAttribute('aria-invalid', String(bad));
    };

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const badEmail = !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim());
      const badConsent = !consent.checked;
      showError(email, emailErr, badEmail);
      showError(consent, consentErr, badConsent);
      if (badEmail) return email.focus();
      if (badConsent) return consent.focus();

      const endpoint = form.dataset.endpoint;
      if (!endpoint) return setState('error', m.errorNotLive);
      setState('sending', m.sending);
      button.disabled = true;
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email.value.trim(), consent: true, lang: document.documentElement.lang }),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        setState('success', m.success);
      } catch {
        setState('error', m.errorNetwork);
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .newsletter {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .newsletter__label {
    font-size: 14px;
    color: var(--ink);
  }
  .newsletter__row {
    display: flex;
    gap: 8px;
  }
  /* Inputs on plum: #908a8e border (5.5:1); #605c5f would fail at 2.8:1. */
  input[type='email'] {
    flex-grow: 1;
    min-width: 0;
    height: 48px;
    padding: 0 18px;
    border: 1px solid #908a8e;
    border-radius: var(--r-pill);
    background: var(--surface-alt);
    color: var(--ink);
    font: 400 15px / 1.4 var(--font);
  }
  input[type='email']::placeholder {
    color: var(--ink-muted);
    opacity: 1;
  }
  input[aria-invalid='true'] {
    border-color: #ffb3c8;
  }
  .newsletter button {
    flex: none;
    min-height: 48px;
    padding: 0 24px;
    font-size: 15px;
  }
  .check {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 8px;
    align-items: start;
    font-size: 14px;
    color: var(--ink-muted);
  }
  .check input {
    width: 20px;
    height: 20px;
    margin: 0;
    accent-color: var(--accent);
  }
  .check a {
    color: var(--ink);
  }
  .field__error {
    color: #ffb3c8;
    font-size: 14px;
    font-weight: 700;
  }
  .field__error[hidden] {
    display: none;
  }
  .newsletter__status:empty {
    display: none;
  }
  .newsletter__status {
    padding: 12px 16px;
    border-radius: var(--r-sm);
    font-size: 14px;
    font-weight: 700;
  }
  .newsletter[data-state='success'] .newsletter__status {
    background: #e6f4ea;
    color: #0b5a23;
  }
  .newsletter[data-state='error'] .newsletter__status {
    background: #fde8ec;
    color: #8a0019;
  }
  .newsletter[data-state='sending'] .newsletter__status {
    background: var(--surface-alt);
    color: var(--ink-muted);
  }
  @media (max-width: 479px) {
    .newsletter__row {
      flex-direction: column;
    }
  }
</style>
