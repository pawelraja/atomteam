---
// "For media" teaser: tiles that deep-link into the media centre. Only materials that can be
// downloaded today get a tile, so the heading ("ready to publish") stays true.
import { anchor, type AnchorKey } from '../lib/anchors';
import { getData } from '../lib/data';
import { copy, fill, type Lang } from '../lib/i18n';
import { findImage } from '../lib/images';
import { route } from '../lib/routes';
import { officialRosterView } from '../lib/view';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { site, media } = getData();
const t = copy(lang);
const tm = t.mediaTeaser;
const base = route(lang, 'media');
const status = (id: string) => media.files.find((f) => f.id === id)?.status ?? 'soon';
const rosterSeason = officialRosterView().season ?? site.currentSeason;
const allTiles: { key: keyof typeof tm.tiles; target: AnchorKey; ready: boolean }[] = [
  { key: 'logos', target: 'files', ready: status('logos') !== 'soon' },
  { key: 'photos', target: 'photos', ready: media.photos.some((p) => findImage('media', p.file)) },
  // Portraits of the current roster are downloadable from the roster table today.
  { key: 'portraits', target: 'roster', ready: true },
  { key: 'info', target: 'files', ready: status('team-info') !== 'soon' },
];
const tiles = allTiles.filter((tile) => tile.ready);
---

<section class="media-teaser" id={anchor(lang, 'for-media')} data-section="for-media" aria-labelledby="media-teaser-title">
  <div class="container media-teaser__inner">
    <div class="head">
      <div class="head__title">
        <p class="eyebrow">{tm.eyebrow}</p>
        <h2 id="media-teaser-title" class="chapter">{tm.title}</h2>
      </div>
      <a class="btn btn--secondary" href={base}>
        {tm.link} <Icon name="arrow" size={16} />
      </a>
    </div>
    <ul class="tiles" role="list">
      {
        tiles.map((tile) => {
          const x = tm.tiles[tile.key];
          const text = fill(x.text, { season: rosterSeason }, lang);
          return (
            <li>
              <a class="tile" href={`${base}#${anchor(lang, tile.target)}`}>
                <span class="tile__format">{x.format}</span>
                <span class="tile__body">
                  <span class="tile__title">{x.title}</span>
                  <span class="tile__text">{text}</span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .media-teaser {
    padding-block: 120px;
  }
  .media-teaser__inner {
    display: grid;
    gap: 48px;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px 32px;
    flex-wrap: wrap;
  }
  .head__title {
    display: grid;
    gap: 16px;
  }
  .head .btn {
    font-weight: 400;
    white-space: nowrap;
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: 40px;
    height: 100%;
    padding: 28px;
    border: 1px solid var(--line-soft);
    border-radius: var(--r-card);
    color: #000;
    text-decoration: none;
  }
  .tile:hover {
    border-color: var(--accent);
    color: #000;
  }
  .tile__format {
    font-size: 12px;
    font-weight: 700;
    color: var(--accent-strong);
  }
  .tile__body {
    display: grid;
    gap: 4px;
  }
  .tile__title {
    font-size: 22px;
    line-height: 28px;
  }
  .tile:hover .tile__title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .tile__text {
    font-size: 14px;
    color: var(--ink-muted);
  }
  @media (max-width: 1023px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 599px) {
    .media-teaser {
      padding-block: 64px;
    }
    .media-teaser__inner {
      gap: 24px;
    }
    .tiles {
      gap: 10px;
    }
    .tile {
      gap: 18px;
      padding: 16px;
      border-radius: 20px;
    }
    .tile__title {
      font-size: 16px;
      line-height: 1.3;
    }
  }
</style>
