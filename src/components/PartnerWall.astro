---
// Home partner wall. Asymmetric grid: the title sponsor as a large tile, main sponsors and
// institutional partners as smaller tiles, technical partners as one line of text (or a logo
// row once every technical partner's SVG is in public/partners/).
// Until "partnersConfirmed" the previous season's partners are thanked — never shown as current.
import { anchor } from '../lib/anchors';
import { getData } from '../lib/data';
import { copy, fill, type Lang } from '../lib/i18n';
import { partnerLogoExists } from '../lib/images';
import { route } from '../lib/routes';
import { pickPartners } from '../lib/season';
import Icon from './Icon.astro';
import PartnerLogo from './PartnerLogo.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { site, partners } = getData();
const t = copy(lang);
const tw = t.wall;
const shown = pickPartners(partners, site.currentSeason, site.partnersConfirmed);
const title = shown.items.filter((p) => p.tier === 'title');
const tiles = [...shown.items.filter((p) => p.tier === 'main'), ...shown.items.filter((p) => p.tier === 'institutional')];
const technical = shown.items.filter((p) => p.tier === 'technical');
const technicalLogos = technical.length > 0 && technical.every((p) => partnerLogoExists(p.logo));
const short = (name: string) => name.split(' — ')[0];
---

{
  shown.items.length > 0 && (
    <section class="section wall" id={anchor(lang, 'partners')} data-section="partners" aria-labelledby="wall-title">
      <div class="container">
        <div class="wall__head">
          <div class="chapter-head">
            <p class="eyebrow">{tw.eyebrow}</p>
            <h2 id="wall-title" class="chapter">
              {shown.isCurrent ? fill(tw.titleCurrent, { season: shown.season! }, lang) : fill(tw.titleThanks, { season: shown.season! }, lang)}
            </h2>
            {!shown.isCurrent && <p>{fill(tw.thanksNote, { next: site.currentSeason }, lang)}</p>}
          </div>
          <a class="text-link" href={route(lang, 'partners')}>
            {tw.allPartners} <Icon name="arrow" size={18} />
          </a>
        </div>

        <ul class="tiles" role="list">
          {title.map((p) => (
            <li class="tile tile--title">
              <PartnerLogo lang={lang} name={p.name} url={p.url} logo={p.logo} size="xl" />
            </li>
          ))}
          {tiles.map((p) => (
            <li class="tile">
              <PartnerLogo lang={lang} name={p.name} url={p.url} logo={p.logo} size="l" />
            </li>
          ))}
        </ul>

        {technical.length > 0 && (
          <div class="technical">
            <h3 class="eyebrow technical__label">{tw.technical}</h3>
            {technicalLogos ? (
              <ul class="technical__logos" role="list">
                {technical.map((p) => (
                  <li>
                    <PartnerLogo lang={lang} name={p.name} url={p.url} logo={p.logo} size="m" />
                  </li>
                ))}
              </ul>
            ) : (
              <p class="technical__line">
                {technical.map((p, i) => (
                  <>
                    <a href={p.url} target="_blank" rel="noopener sponsored">
                      {short(p.name)}
                      <span class="visually-hidden"> {t.a11y.newTab}</span>
                    </a>
                    {i < technical.length - 1 && <span aria-hidden="true"> · </span>}
                  </>
                ))}
              </p>
            )}
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .wall__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: var(--s-4);
    margin-bottom: var(--s-6);
  }
  .wall__head .chapter-head {
    margin-bottom: 0;
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: var(--s-3);
  }
  .tile :global(.logo) {
    height: 100%;
    min-height: 140px;
    border-radius: var(--r-card);
  }
  .tile--title {
    grid-column: span 2;
    grid-row: span 2;
  }
  .tile--title :global(.logo) {
    min-height: 296px;
    background: var(--surface-alt);
    border-color: transparent;
    box-shadow: var(--shadow-card);
  }
  .technical {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-5);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }
  .technical__line {
    font-size: var(--fs-body-lg);
    line-height: 1.8;
  }
  .technical__line a {
    text-decoration: none;
  }
  .technical__line a:hover {
    text-decoration: underline;
  }
  .technical__logos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: var(--s-3);
  }
  @media (max-width: 899px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .tile--title :global(.logo) {
      min-height: 200px;
    }
  }
  @media (max-width: 479px) {
    .tile--title {
      grid-row: span 1;
    }
    .tile :global(.logo) {
      min-height: 112px;
    }
  }
</style>
