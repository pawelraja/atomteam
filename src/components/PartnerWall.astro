---
// Home partner wall. Asymmetric 12-column grid: the title sponsor as a large tile, main sponsors
// and institutional partners as smaller tiles, technical partners as one line of text (or a logo
// row once every technical partner's SVG is in public/partners/).
// Until "partnersConfirmed" the previous season's partners are thanked — never shown as current.
import { anchor } from '../lib/anchors';
import { getData } from '../lib/data';
import { copy, fill, pick, type Lang } from '../lib/i18n';
import { partnerLogoExists } from '../lib/images';
import type { Partner } from '../lib/schemas';
import { pickPartners } from '../lib/season';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { site, partners } = getData();
const t = copy(lang);
const tw = t.wall;
const shown = pickPartners(partners, site.currentSeason, site.partnersConfirmed);
const of = (tier: Partner['tier']) => shown.items.filter((p) => p.tier === tier);
const [title, main, institutional, technical] = [of('title'), of('main'), of('institutional'), of('technical')];
const technicalLogos = technical.length > 0 && technical.every((p) => partnerLogoExists(p.logo));
const label = (p: Partner) => (p.label ? pick(lang, p.label) : p.name.split(' — ')[0]);
const logo = (p: Partner) => (partnerLogoExists(p.logo) ? `/partners/${p.logo}` : null);
---

{
  shown.items.length > 0 && (
    <section class="wall" id={anchor(lang, 'partners')} data-section="partners" aria-labelledby="wall-title">
      <div class="container wall__inner">
        <div class="wall__head">
          <h2 id="wall-title" class="wall__title">
            {shown.isCurrent ? fill(tw.titleCurrent, { season: shown.season! }, lang) : fill(tw.titleThanks, { season: shown.season! }, lang)}
          </h2>
          {!shown.isCurrent && <p class="wall__note">{fill(tw.thanksNote, { next: site.currentSeason }, lang)}</p>}
        </div>

        <ul class="tiles" role="list">
          {title.map((p) => (
            <li class="tile tile--title">
              <a href={p.url} target="_blank" rel="noopener sponsored">
                <span class="tile__tier">{tw.title}</span>
                {logo(p) ? <img src={logo(p)} alt={label(p)} loading="lazy" width="320" height="120" /> : <span class="tile__name">{label(p)}</span>}
                <span class="visually-hidden"> {t.a11y.newTab}</span>
              </a>
            </li>
          ))}
          {main.map((p) => (
            <li class="tile tile--main">
              <a href={p.url} target="_blank" rel="noopener sponsored">
                {logo(p) ? <img src={logo(p)} alt={label(p)} loading="lazy" width="160" height="56" /> : label(p)}
                <span class="visually-hidden"> {t.a11y.newTab}</span>
              </a>
            </li>
          ))}
          {institutional.map((p) => (
            <li class="tile tile--inst">
              <a href={p.url} target="_blank" rel="noopener sponsored">
                {logo(p) ? <img src={logo(p)} alt={label(p)} loading="lazy" width="160" height="56" /> : label(p)}
                <span class="tile__sub">{tw.institutional}</span>
                <span class="visually-hidden"> {t.a11y.newTab}</span>
              </a>
            </li>
          ))}
        </ul>

        {technical.length > 0 &&
          (technicalLogos ? (
            <div class="technical">
              <h3 class="technical__label">{tw.technical}</h3>
              <ul class="technical__logos" role="list">
                {technical.map((p) => (
                  <li>
                    <a href={p.url} target="_blank" rel="noopener sponsored">
                      <img src={logo(p)} alt={label(p)} loading="lazy" width="120" height="40" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ) : (
            <p class="technical__line">
              <span class="technical__label">{tw.technical}</span>{' '}
              {technical.map((p, i) => (
                <>
                  <a href={p.url} target="_blank" rel="noopener sponsored">
                    {label(p)}
                    <span class="visually-hidden"> {t.a11y.newTab}</span>
                  </a>
                  {i < technical.length - 1 && <span aria-hidden="true"> · </span>}
                </>
              ))}
            </p>
          ))}
      </div>
    </section>
  )
}

<style>
  .wall {
    padding-block: 96px;
  }
  .wall__inner {
    display: grid;
    gap: 32px;
  }
  .wall__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px 32px;
    flex-wrap: wrap;
  }
  .wall__title {
    font-size: 34px;
    line-height: 42px;
  }
  .wall__note {
    font-size: 14px;
    color: var(--ink-muted);
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 16px;
  }
  .tile a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    height: 100%;
    min-height: 96px;
    padding: 12px;
    border: 1px solid #e4e0e6;
    border-radius: var(--r-sm);
    color: #000;
    text-decoration: none;
    font-size: 18px;
    text-align: center;
  }
  .tile a:hover {
    border-color: var(--accent);
    color: #000;
  }
  .tile img {
    max-height: 56px;
    max-width: 80%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .tile--title {
    grid-column: span 6;
    grid-row: span 2;
  }
  .tile--title a {
    min-height: 208px;
    align-items: flex-start;
    justify-content: space-between;
    padding: 28px;
    border: 0;
    border-radius: var(--r-card);
    background: var(--surface-alt);
    text-align: left;
  }
  .tile--title img {
    max-height: 88px;
  }
  .tile__tier {
    font-size: 12px;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .tile__name {
    font-size: 40px;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .tile--main {
    grid-column: span 2;
  }
  .tile--inst {
    grid-column: span 3;
  }
  .tile--inst a {
    font-size: 16px;
  }
  .tile__sub {
    font-size: 12px;
    color: var(--ink-muted);
  }
  .technical__line {
    font-size: 14px;
    line-height: 22px;
    color: var(--ink-muted);
  }
  .technical__line a {
    color: var(--ink-muted);
    text-decoration: none;
  }
  .technical__line a:hover {
    color: var(--accent-strong);
    text-decoration: underline;
  }
  .technical__label {
    color: #000;
    font-size: 14px;
    font-weight: 400;
  }
  .technical {
    display: grid;
    gap: 12px;
  }
  .technical__logos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 12px;
  }
  .technical__logos a {
    display: grid;
    place-items: center;
    height: 72px;
    padding: 12px;
    border: 1px solid #e4e0e6;
    border-radius: var(--r-sm);
  }
  .technical__logos img {
    max-height: 40px;
    width: auto;
  }
  @media (max-width: 1023px) {
    .tile--title {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .tile--main {
      grid-column: span 4;
    }
    .tile--inst {
      grid-column: span 6;
    }
  }
  @media (max-width: 599px) {
    .wall {
      padding-block: 64px;
    }
    .wall__title {
      font-size: 28px;
      line-height: 1.25;
    }
    .tile--title a {
      min-height: 160px;
    }
    .tile__name {
      font-size: 32px;
    }
    .tile--main,
    .tile--inst {
      grid-column: span 6;
    }
  }
</style>
