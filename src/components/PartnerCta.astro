---
// "Ride with us in 2027." — the key conversion block, a plum band right after Partners.
import { anchor } from '../lib/anchors';
import { getData } from '../lib/data';
import { copy, fill, type Lang } from '../lib/i18n';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { site } = getData();
const t = copy(lang);
const tc = t.partnerCta;
const season = site.currentSeason;
const mailto = `mailto:${t.team.email}?subject=${encodeURIComponent(fill(tc.mailSubject, { season }).replace(/ /g, ' '))}`;
---

<section class="section cta" id={anchor(lang, 'partner-cta')} data-section="partner-cta" data-theme="dark" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta__head">
      <h2 id="cta-title" class="cta__title">{fill(tc.title, { season }, lang)}</h2>
      <p class="body-lg cta__lead">{tc.lead}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={mailto}>
          <Icon name="mail" size={20} />
          {fill(tc.mail, { season }, lang)}
        </a>
        {
          site.partnerDeckUrl && (
            <a class="btn btn--secondary" href={site.partnerDeckUrl} download>
              <Icon name="download" size={20} />
              {fill(tc.deck, { season }, lang)}
            </a>
          )
        }
      </div>
    </div>

    <ul class="values" role="list">
      {
        tc.values.map((v) => (
          <li class="value">
            <h3 class="value__title">{v.title}</h3>
            <p class="value__line">{v.line}</p>
          </li>
        ))
      }
    </ul>

    <h3 class="packages__title">{tc.packagesTitle}</h3>
    <ul class="packages" role="list">
      {
        tc.packages.map((p, i) => (
          <li class:list={['package', { 'package--feature': i === 0 }]}>
            <h4 class="package__tier">{p.tier}</h4>
            <ul class="package__list" role="list">
              {p.benefits.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
            <p class="package__note caption">{tc.packagesNote}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cta__head {
    display: grid;
    gap: var(--s-4);
    max-width: 820px;
    margin-bottom: var(--s-6);
  }
  .cta__title {
    color: var(--accent);
  }
  .cta__lead {
    color: var(--ink);
  }
  .values {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-5);
    margin-bottom: var(--s-6);
  }
  .value {
    padding-top: var(--s-3);
    border-top: 2px solid var(--accent);
  }
  .value__title {
    font-size: 22px;
    line-height: 1.3;
    font-weight: 700;
  }
  .value__line {
    margin-top: var(--s-2);
    color: var(--ink-muted);
  }
  .packages__title {
    margin-bottom: var(--s-4);
  }
  .packages {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-4);
  }
  .package {
    display: grid;
    align-content: start;
    gap: var(--s-3);
    padding: var(--s-5);
    border-radius: var(--r-card);
    background: var(--surface-alt);
    box-shadow: var(--shadow-card);
  }
  .package--feature {
    box-shadow: var(--shadow-feature);
  }
  .package__tier {
    font-size: var(--fs-h3);
    line-height: 1.25;
    font-weight: 400;
  }
  .package__list {
    display: grid;
    gap: var(--s-2);
  }
  .package__list li {
    position: relative;
    padding-left: 22px;
  }
  .package__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
  }
  .package__note {
    color: var(--ink-muted);
  }
  @media (max-width: 899px) {
    .values,
    .packages {
      grid-template-columns: 1fr;
    }
  }
</style>
