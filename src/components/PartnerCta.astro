---
// The partnership call to action (plum): "Ride with us in 2027." with a mailto button, the
// partner deck ("coming soon" until partnerDeckUrl is set) and the partnership contact card.
import { anchor } from '../lib/anchors';
import { getData } from '../lib/data';
import { copy, fill, type Lang } from '../lib/i18n';
import { isContactComplete } from '../lib/showcase';
import ContactCard from './ContactCard.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { site } = getData();
const t = copy(lang);
const tc = t.cta;
const season = site.currentSeason;
const contact = site.partnerContact;
const email = (isContactComplete(contact) && contact?.email) || t.team.email;
const mailto = `mailto:${email}?subject=${encodeURIComponent(fill(tc.mailSubject, { season }))}`;
---

<section class="cta" data-theme="dark" id={anchor(lang, 'cta')} data-section="cta" aria-labelledby="cta-title">
  <div class="container cta__grid">
    <div class="cta__main">
      <h2 id="cta-title" class="cta__title">{fill(tc.title, { season }, lang)}</h2>
      <p class="cta__lead">{tc.lead}</p>
      <div class="cta__buttons">
        <a class="btn btn--primary" href={mailto}>{tc.book}</a>
        {
          site.partnerDeckUrl ? (
            <a class="btn btn--secondary cta__deck" href={site.partnerDeckUrl} download>
              <Icon name="download" size={18} />
              {tc.deck}
            </a>
          ) : (
            <span class="btn cta__deck cta__deck--soon">
              {tc.deck} · {tc.deckSoon}
            </span>
          )
        }
      </div>
    </div>
    <ContactCard lang={lang} contact={contact} label={tc.contactLabel} class="cta__card" />
  </div>
</section>

<style>
  .cta {
    padding-block: 104px;
    background: var(--surface);
    color: var(--ink);
  }
  .cta__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--grid-gap);
    align-items: center;
  }
  .cta__main {
    grid-column: span 7;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .cta__grid :global(.cta__card) {
    grid-column: 9 / span 4;
  }
  /* Display size (72px): pink on plum is 7.5:1. */
  .cta__title {
    font-size: var(--fs-display);
    line-height: 1;
    letter-spacing: var(--ls-hero);
    font-weight: 400;
    color: var(--accent);
    text-wrap: balance;
  }
  .cta__lead {
    max-width: 560px;
    font-size: 18px;
    line-height: 1.45;
  }
  .cta__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
  .cta__deck {
    color: var(--ink);
  }
  .cta__deck--soon {
    border: 1px dashed #908a8e;
    color: var(--ink-muted);
    font-weight: 400;
    cursor: default;
  }
  @media (max-width: 1023px) {
    .cta__main,
    .cta__grid :global(.cta__card) {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 599px) {
    .cta {
      padding-block: 64px;
    }
    .cta__buttons {
      flex-direction: column;
    }
  }
</style>
