---
// "One team from junior to elite": the pathway U19 → U23 → Elite with rider counts from
// riders.json, and three pillars. Staff size comes from staff.json, the UCI races from the calendar.
import { anchor } from '../lib/anchors';
import { getData } from '../lib/data';
import { copy, fill, plural, typo, type Lang } from '../lib/i18n';
import { CATEGORY_ORDER, listJoin, rosterSplit, topUciRaces } from '../lib/showcase';
import { officialRosterView, teamView } from '../lib/view';

interface Props {
  lang: Lang;
  /** "chapter" on the home page; "pathway" on the team page (diagram only). */
  variant?: 'chapter' | 'pathway';
}
const { lang, variant = 'chapter' } = Astro.props;
const { site, calendars } = getData();
const t = copy(lang);
const ta = t.approach;
const tp = ta.pillars;
const roster = officialRosterView();
const split = rosterSplit(roster.items);
const stages = CATEGORY_ORDER.map((c) => ({
  id: c,
  ...ta.stages[c],
  count: plural(ta.stageCount, split[c], lang, { season: roster.season ?? site.currentSeason }),
}));
const crew = teamView().crew.items;

// "Scheldeprijs, De Brabantse Pijl i Lotto Thüringen (1.Pro) oraz Tour de Pologne Women (2.Pro)"
const uci = topUciRaces(calendars, site.currentSeason);
const uciText = uci
  ? fill(
      tp.uci.text,
      {
        season: uci.season,
        races: [...new Set(uci.races.map((e) => e.cls!))]
          .sort()
          .map((cls) => `${listJoin(uci.races.filter((e) => e.cls === cls).map((e) => e.short ?? e.name), t.meta.locale)} (${cls})`)
          .join(tp.uci.groupJoin),
      },
      lang,
    )
  : fill(tp.uci.empty, { season: site.currentSeason }, lang);
const id = variant === 'chapter' ? 'approach-title' : 'pathway-title';
---

<section
  class:list={['approach', { 'approach--pathway': variant === 'pathway' }]}
  id={variant === 'chapter' ? anchor(lang, 'approach') : undefined}
  data-section={variant === 'chapter' ? 'approach' : undefined}
  aria-labelledby={id}
>
  <div class="container approach__inner">
    <div class="approach__head">
      <div class="approach__title">
        <p class="eyebrow">{ta.eyebrow}</p>
        <h2 id={id} class="chapter">{ta.title}</h2>
      </div>
      <p class="approach__lead">{ta.lead}</p>
    </div>

    {
      roster.items.length > 0 && (
        <ol class="pathway" role="list" aria-label={ta.pathwayLabel}>
          {stages.map((s) => (
            <li class="stage">
              <span class:list={['stage__badge', { 'stage__badge--top': s.id === 'Elite' }]} aria-hidden="true">
                {s.badge}
              </span>
              <div class="stage__text">
                <h3 class="stage__name">
                  {s.name}
                  <span class="stage__inline-count" aria-hidden="true"> · {split[s.id]}</span>
                </h3>
                <p class="stage__desc">
                  <span class="stage__count">{s.count}</span> {s.text}
                </p>
              </div>
            </li>
          ))}
        </ol>
      )
    }

    {
      variant === 'chapter' && (
        <div class="pillars">
          <article class="pillar">
            <p class="eyebrow">{tp.staff.eyebrow}</p>
            <h3 class="pillar__title">{plural(tp.staff.title, crew.length, lang)}</h3>
            <p class="pillar__text">{tp.staff.text}</p>
          </article>
          <article class="pillar">
            <p class="eyebrow">{tp.clubPro.eyebrow}</p>
            <h3 class="pillar__title">{tp.clubPro.title}</h3>
            <p class="pillar__text">{tp.clubPro.text}</p>
          </article>
          <article class="pillar">
            <p class="eyebrow">{tp.uci.eyebrow}</p>
            <h3 class="pillar__title">{tp.uci.title}</h3>
            <p class="pillar__text">{typo(lang, uciText)}</p>
          </article>
        </div>
      )
    }
  </div>
</section>

<style>
  .approach {
    padding-block: 120px;
  }
  .approach__inner {
    display: grid;
    gap: 64px;
  }
  .approach__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--grid-gap);
    align-items: end;
  }
  .approach__title {
    grid-column: span 7;
    display: grid;
    gap: 16px;
  }
  .approach__lead {
    grid-column: 9 / span 4;
    font-size: 17px;
    line-height: 1.47;
    color: var(--ink-muted);
  }
  .approach--pathway .approach__head {
    display: none;
  }

  /* Pathway: a violet line through three circles. Violet, not pink: pink on white is 2.5:1. */
  .pathway {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .pathway::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 36px;
    height: 2px;
    background: var(--accent-strong);
  }
  .stage {
    position: relative;
    display: grid;
    align-content: start;
    gap: 20px;
    padding-right: 32px;
  }
  .stage__badge {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: var(--r-pill);
    background: var(--surface);
    border: 2px solid var(--accent-strong);
    font-size: 20px;
    font-weight: 700;
  }
  .stage__badge--top {
    background: var(--accent);
    color: var(--ink-on-accent);
    font-size: 18px;
  }
  .stage__text {
    display: grid;
    gap: 6px;
  }
  .stage__name {
    font-size: 28px;
    line-height: 36px;
  }
  .stage__inline-count {
    display: none;
  }
  .stage__desc {
    font-size: 15px;
    line-height: 1.4;
    color: var(--ink-muted);
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }
  .pillar {
    display: grid;
    align-content: start;
    gap: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .pillar__title {
    font-size: 24px;
    line-height: 32px;
  }
  .pillar__text {
    font-size: 15px;
    line-height: 1.47;
    color: var(--ink-muted);
  }

  @media (max-width: 899px) {
    .approach {
      padding-block: 64px;
    }
    .approach__inner {
      gap: 28px;
    }
    .approach__head,
    .pillars {
      grid-template-columns: 1fr;
    }
    .approach__title,
    .approach__lead {
      grid-column: auto;
    }
    /* Phones: the pathway runs down a vertical violet line. */
    .pathway {
      grid-template-columns: 1fr;
      gap: 24px;
      margin-left: 18px;
      padding-left: 36px;
      border-left: 2px solid var(--accent-strong);
    }
    .pathway::before {
      display: none;
    }
    .stage {
      padding-right: 0;
      gap: 4px;
    }
    .stage__badge {
      position: absolute;
      left: -57px;
      top: -4px;
      width: 40px;
      height: 40px;
      font-size: 12px;
    }
    .stage__badge--top {
      font-size: 11px;
    }
    .stage__name {
      font-size: 20px;
      line-height: 1.3;
    }
    .stage__inline-count {
      display: inline;
    }
    .stage__count {
      /* The count is in the heading on phones; keep it for screen readers only. */
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .stage__desc {
      font-size: 14px;
    }
    .pillars {
      gap: 28px;
    }
  }
</style>
