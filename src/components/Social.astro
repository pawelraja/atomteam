---
import Icon from './Icon.astro';
import { copy, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  size?: number;
  class?: string;
}
const { lang, size = 22 } = Astro.props;
const t = copy(lang);
const links = [
  { name: 'instagram', href: t.team.social.instagram, label: t.a11y.socialInstagram },
  { name: 'facebook', href: t.team.social.facebook, label: t.a11y.socialFacebook },
  { name: 'linkedin', href: t.team.social.linkedin, label: t.a11y.socialLinkedin },
] as const;
---

<ul class:list={['social', Astro.props.class]} role="list">
  {
    links.map((l) => (
      <li>
        <a href={l.href} target="_blank" rel="noopener me" aria-label={`${l.label} ${t.a11y.newTab}`}>
          <Icon name={l.name} size={size} />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social {
    display: flex;
    gap: var(--s-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-pill);
    color: var(--ink);
  }
  a:hover {
    color: var(--accent-strong);
    background: color-mix(in srgb, var(--accent) 18%, transparent);
  }
</style>
