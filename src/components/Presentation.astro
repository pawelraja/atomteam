---
// Team presentation countdown. Rendered only when site.json has "teamPresentation"; the
// browser removes it automatically once the date has passed, even without a rebuild.
import { anchor } from '../lib/anchors';
import { getData } from '../lib/data';
import { copy, fill, plural, type Lang } from '../lib/i18n';
import { presentationCountdown } from '../lib/season';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { site, today } = getData();
const t = copy(lang);
const tp = presentationCountdown(site.teamPresentation, today);
const date = tp
  ? new Intl.DateTimeFormat(t.meta.locale, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(tp.date + 'T00:00:00Z'))
  : '';
---

{
  tp && (
    <aside
      class="presentation"
      id={anchor(lang, 'presentation')}
      data-section="presentation"
      data-theme="dark"
      data-presentation
      data-date={tp.date}
      aria-labelledby="presentation-label"
    >
      <div class="container presentation__inner">
        <p class="presentation__label" id="presentation-label">{fill(t.presentation.label, { season: site.currentSeason }, lang)}</p>
        <p class="presentation__line">{fill(t.presentation.line, { date, place: tp.place }, lang)}</p>
        <p class="presentation__days lead" data-days>{plural(t.presentation.days, tp.daysToGo, lang)}</p>
        {tp.url && (
          <a class="btn btn--primary" href={tp.url}>
            {t.presentation.link} <Icon name="arrow" size={18} />
          </a>
        )}
      </div>
      <script type="application/json" id="presentation-days" set:html={JSON.stringify(t.presentation.days)} />
    </aside>
  )
}

<script>
  import { clientLang, clientToday, readJSON } from '../lib/client';
  import { plural } from '../lib/text';
  import { presentationCountdown } from '../lib/season';

  const el = document.querySelector<HTMLElement>('[data-presentation]');
  if (el) {
    const cd = presentationCountdown({ date: el.dataset.date!, place: '' }, clientToday());
    if (!cd) el.remove();
    else el.querySelector('[data-days]')!.textContent = plural(readJSON('presentation-days'), cd.daysToGo, clientLang());
  }
</script>

<style>
  .presentation {
    background: var(--surface-alt);
    color: var(--ink);
    padding-block: var(--s-4);
  }
  .presentation__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-5);
  }
  .presentation__label {
    color: var(--accent);
    font-weight: 700;
  }
  .presentation__line {
    font-size: var(--fs-body-lg);
  }
  .presentation__days {
    margin-left: auto;
  }
</style>
