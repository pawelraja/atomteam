---
// Four photos at mixed widths ("use": "strip" in gallery.json), with caption and photographer
// credit, followed by the #allezatomówki ticker.
import { getData } from '../lib/data';
import { copy, fill, pick, type Lang } from '../lib/i18n';
import Photo from './Photo.astro';
import Ticker from './Ticker.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { gallery } = getData();
const t = copy(lang);
const photos = gallery.filter((g) => g.use === 'strip').slice(0, 4);
const sizes = ['(min-width: 900px) 38vw, 100vw', '(min-width: 900px) 19vw, 50vw', '(min-width: 900px) 26vw, 50vw', '(min-width: 900px) 19vw, 100vw'];
---

<section class="strip" aria-labelledby="strip-title">
  <h2 id="strip-title" class="visually-hidden">{t.gallery.title}</h2>
  <ul class="strip__row" role="list">
    {
      photos.map((p, i) => (
        <li class:list={['shot', `shot--${i + 1}`]}>
          <figure>
            <Photo lang={lang} dir="photos" file={p.photo} alt={pick(lang, p.alt)} aspect={i === 0 ? '4:3' : '3:4'} sizes={sizes[i]} widths={[360, 540, 720, 1080]} class="shot__img" />
            <figcaption class="shot__caption">
              {pick(lang, p.race)} · {pick(lang, p.place)} · {fill(t.gallery.credit, { credit: p.credit })}
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
  <Ticker lang={lang} />
</section>

<style>
  .strip {
    padding-bottom: 120px;
    overflow: hidden;
  }
  .strip__row {
    display: grid;
    grid-template-columns: 2fr 1fr 1.4fr 1fr;
    gap: 16px;
    padding: 0 16px;
    height: clamp(420px, 40vw, 640px);
    margin-bottom: 56px;
  }
  .shot figure {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: var(--r-card);
    background: var(--surface-muted);
  }
  .shot--1 figure {
    border-radius: var(--r-feature);
  }
  .shot :global(.shot__img) {
    height: 100%;
    aspect-ratio: auto !important;
  }
  .shot :global(.shot__img img) {
    height: 100%;
  }
  .shot__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 28px 20px 16px;
    background: linear-gradient(to top, rgba(43, 0, 32, 0.85), rgba(43, 0, 32, 0));
    color: #f1eef3;
    font-size: 14px;
  }
  @media (max-width: 899px) {
    .strip {
      padding-bottom: 64px;
    }
    .strip__row {
      grid-template-columns: 1fr 1fr;
      height: auto;
      margin-bottom: 32px;
    }
    .shot figure {
      height: clamp(200px, 56vw, 360px);
    }
    .shot--1,
    .shot--4 {
      grid-column: 1 / -1;
    }
  }
</style>
