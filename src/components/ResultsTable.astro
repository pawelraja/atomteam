---
// Results as a real table. Places never rely on colour alone: 1st is a filled pink pill, 2nd a
// solid outline, 3rd a dashed outline, 4th and lower plain text — each with the number and a
// spoken name ("1. miejsce").
import { copy, fill, type Lang } from '../lib/i18n';
import { categoryLabel, resultLabel, stageLabel, teamLine, type EventIndex } from '../lib/results';
import { riderPath } from '../lib/routes';
import type { Result } from '../lib/schemas';
import { riderSlug } from '../lib/showcase';
import { getData } from '../lib/data';
import { raceHref } from '../lib/view';

interface Props {
  lang: Lang;
  rows: Result[];
  events: EventIndex;
  caption: string;
  /**
   * "featured": place · rider · race (home). "rider": place · race · date · source (profile).
   * "race": place · rider · classification · source (race page).
   */
  variant?: 'featured' | 'rider' | 'race';
  captionHidden?: boolean;
  /** Season of the rows: race names then link to their race pages. */
  season?: number;
}
const { lang, rows, events, caption, variant = 'featured', captionHidden = false, season } = Astro.props;
const href = (eventId: string) => (season === undefined ? null : raceHref(lang, season, eventId));
const classification = (r: Result) => [stageLabel(r.stage, tr.stages), categoryLabel(r.category, tr.categories)].filter(Boolean).join(' · ') || r.stage;
const t = copy(lang);
const tr = t.results;
const riders = new Map(getData().riders.map((r) => [r.name, r]));
const placeName = (p: number) => (p <= 3 ? tr.placeName[String(p) as '1' | '2' | '3'] : fill(tr.placeName.other, { n: p }));
const dateFmt = new Intl.DateTimeFormat(t.meta.locale, { day: 'numeric', month: 'short', timeZone: 'UTC' });
---

<table class:list={['results-table', `results-table--${variant}`]}>
  <caption class:list={{ 'visually-hidden': captionHidden }}>{caption}</caption>
  <thead>
    <tr>
      <th scope="col" class="col-place">{tr.place}</th>
      {variant !== 'rider' && <th scope="col">{tr.rider}</th>}
      <th scope="col">{variant === 'race' ? tr.classification : tr.event}</th>
      {variant === 'rider' && <th scope="col" class="col-date">{tr.date}</th>}
      {variant !== 'featured' && <th scope="col" class="col-source">{tr.source}</th>}
    </tr>
  </thead>
  <tbody>
    {
      rows.map((r) => {
        const rider = riders.get(r.rider);
        const team = teamLine(r);
        const text = resultLabel(r, events, lang, tr);
        const link = variant === 'race' ? null : href(r.eventId);
        const label = link ? <a class="event-link" href={link}>{text}</a> : text;
        return (
          <tr>
            <td class="place">
              <span class:list={['badge', `badge--${Math.min(r.position ?? 4, 4)}`]}>
                <span aria-hidden="true">{r.position}.</span>
                <span class="visually-hidden">{placeName(r.position ?? 0)}</span>
              </span>
            </td>
            {variant !== 'rider' && (
              <th scope="row" class="rider">
                {team ? team : rider ? <a href={riderPath(lang, riderSlug(rider))}>{r.rider}</a> : r.rider}
              </th>
            )}
            {variant === 'race' ? (
              <td class="event">{classification(r)}</td>
            ) : variant === 'featured' ? (
              <td class="event">{label}</td>
            ) : (
              <th scope="row" class="event event--rider">
                {label}
                {team && <span class="event__team">{team}</span>}
              </th>
            )}
            {variant === 'rider' && <td class="date">{r.date ? <time datetime={r.date}>{dateFmt.format(new Date(r.date + 'T00:00:00Z'))}</time> : ''}</td>}
            {variant !== 'featured' && (
              <td class="source">
                <a href={r.source} target="_blank" rel="noopener">
                  {new URL(r.source).hostname.replace(/^www\./, '')}
                  <span class="visually-hidden"> {t.a11y.newTab}</span>
                </a>
              </td>
            )}
          </tr>
        );
      })
    }
  </tbody>
</table>

<style>
  .results-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
    line-height: 1.4;
  }
  caption {
    text-align: left;
    padding-bottom: 12px;
    font-size: 12px;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  thead th {
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  tbody td,
  tbody th {
    padding: 18px 16px 18px 0;
    border-bottom: 1px solid var(--surface-alt);
    text-align: left;
    vertical-align: top;
    font-weight: 400;
  }
  .col-place {
    width: 96px;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    height: 30px;
    padding: 0 10px;
    border-radius: var(--r-pill);
    font-size: 14px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .badge--1 {
    background: var(--accent);
    color: var(--ink-on-accent);
  }
  .badge--2 {
    border: 2px solid var(--ink);
  }
  .badge--3 {
    border: 2px dashed var(--ink-muted);
  }
  .badge--4 {
    color: var(--ink-muted);
  }
  .rider {
    font-size: 18px;
    color: var(--ink);
  }
  .rider a {
    color: inherit;
    text-decoration: none;
  }
  .rider a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
  .event {
    color: var(--ink-muted);
  }
  .event-link {
    color: inherit;
    text-decoration: none;
  }
  .event-link:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
  .event--rider {
    color: var(--ink);
  }
  .event__team {
    display: block;
    color: var(--ink-muted);
    font-size: 14px;
  }
  .date,
  .col-date {
    white-space: nowrap;
    color: var(--ink-muted);
  }
  .source a {
    font-size: 14px;
  }
  @media (max-width: 599px) {
    .col-place {
      width: 64px;
    }
    .rider {
      font-size: 16px;
    }
    tbody td,
    tbody th {
      padding: 14px 10px 14px 0;
    }
    .event {
      font-size: 14px;
    }
    .col-source,
    .source {
      display: none;
    }
  }
</style>
