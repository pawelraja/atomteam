---
// Contact + newsletter. The form is not wired to a provider: set NEWSLETTER_ENDPOINT at build
// time and it POSTs JSON { email, consent, lang } there. Without it, submitting shows a friendly note.
import { anchor } from '../lib/anchors';
import { getData } from '../lib/data';
import { copy, fill, type Lang } from '../lib/i18n';
import Social from './Social.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { site } = getData();
const t = copy(lang);
const tc = t.contact;
const season = site.currentSeason;
const endpoint = import.meta.env.NEWSLETTER_ENDPOINT || process.env.NEWSLETTER_ENDPOINT || '';
const messages = {
  sending: tc.sending,
  success: fill(tc.success, { season }, lang),
  errorEmail: tc.errorEmail,
  errorConsent: tc.errorConsent,
  errorNetwork: fill(tc.errorNetwork, { email: t.team.email }, lang),
  errorNotLive: fill(tc.errorNotLive, { email: t.team.email }, lang),
};
---

<section class="section contact" id={anchor(lang, 'contact')} data-section="contact" aria-labelledby="contact-title">
  <div class="container contact__grid">
    <div class="contact__info">
      <h2 id="contact-title">{tc.title}</h2>
      <p class="body-lg muted">{tc.lead}</p>
      <a class="contact__email" href={`mailto:${t.team.email}`}>{t.team.email}</a>
      <div class="contact__follow">
        <p class="caption muted">{tc.follow}</p>
        <Social lang={lang} size={26} />
      </div>
    </div>

    <form
      class="newsletter card"
      id={anchor(lang, 'newsletter')}
      data-section="contact"
      action={endpoint || undefined}
      method="post"
      novalidate
      data-newsletter
      data-endpoint={endpoint}
      aria-labelledby="newsletter-title"
    >
      <h3 id="newsletter-title" class="newsletter__title">{fill(tc.newsletterTitle, { season }, lang)}</h3>
      <input type="hidden" name="lang" value={lang} />

      <div class="field">
        <label for="nl-email">{tc.emailLabel} <span class="muted">{tc.required}</span></label>
        <input id="nl-email" name="email" type="email" autocomplete="email" required aria-describedby="nl-email-error" placeholder="" />
        <p class="field__error" id="nl-email-error" hidden>{tc.errorEmail}</p>
      </div>

      <div class="check">
        <input id="nl-consent" name="consent" type="checkbox" value="yes" required aria-describedby="nl-consent-error" />
        <label for="nl-consent">
          {tc.consent}{' '}
          <a href={t.footer.privacyUrl}>{tc.consentPrivacy}</a>
        </label>
      </div>
      <p class="field__error" id="nl-consent-error" hidden>{tc.errorConsent}</p>

      <button class="btn btn--primary" type="submit">{tc.submit}</button>
      <p class="newsletter__status" role="status" aria-live="polite" data-status></p>
      <script type="application/json" id="newsletter-copy" set:html={JSON.stringify(messages)} />
    </form>
  </div>
</section>

<script>
  import { readJSON } from '../lib/client';

  type Msg = Record<'sending' | 'success' | 'errorEmail' | 'errorConsent' | 'errorNetwork' | 'errorNotLive', string>;
  const form = document.querySelector<HTMLFormElement>('[data-newsletter]');
  if (form) {
    const m = readJSON<Msg>('newsletter-copy');
    const email = form.querySelector<HTMLInputElement>('#nl-email')!;
    const consent = form.querySelector<HTMLInputElement>('#nl-consent')!;
    const emailErr = form.querySelector<HTMLElement>('#nl-email-error')!;
    const consentErr = form.querySelector<HTMLElement>('#nl-consent-error')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const setState = (kind: 'idle' | 'sending' | 'success' | 'error', text = '') => {
      form.dataset.state = kind;
      status.textContent = text;
    };
    const showError = (input: HTMLInputElement, err: HTMLElement, bad: boolean) => {
      err.hidden = !bad;
      input.setAttribute('aria-invalid', String(bad));
    };

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const badEmail = !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim());
      const badConsent = !consent.checked;
      showError(email, emailErr, badEmail);
      showError(consent, consentErr, badConsent);
      if (badEmail) return email.focus();
      if (badConsent) return consent.focus();

      const endpoint = form.dataset.endpoint;
      if (!endpoint) return setState('error', m.errorNotLive);
      setState('sending', m.sending);
      button.disabled = true;
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email.value.trim(), consent: true, lang: document.documentElement.lang }),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        setState('success', m.success);
      } catch {
        setState('error', m.errorNetwork);
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s-6);
    align-items: start;
  }
  .contact__info {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
  }
  .contact__email {
    font-size: clamp(24px, 3vw, 34px);
    line-height: 1.2;
    word-break: break-word;
  }
  .contact__follow {
    display: grid;
    gap: var(--s-1);
  }
  .contact__follow :global(.social) {
    margin-left: -10px;
  }
  .newsletter {
    display: grid;
    gap: var(--s-4);
    padding: clamp(24px, 4vw, 40px);
    background: var(--surface-alt);
  }
  .newsletter__title {
    font-size: var(--fs-h3);
    line-height: 1.3;
  }
  .field {
    display: grid;
    gap: var(--s-2);
  }
  label {
    font-size: var(--fs-body-sm);
  }
  input[type='email'] {
    min-height: 52px;
    padding: 12px 20px;
    border: 1px solid var(--ink-muted);
    border-radius: var(--r-pill);
    background: var(--surface);
    color: var(--ink);
    font: 400 var(--fs-body) / 1.4 var(--font);
  }
  input[type='email']:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  input[aria-invalid='true'] {
    border-color: #b00020;
  }
  .check {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: var(--s-2);
    align-items: start;
  }
  .check input {
    width: 22px;
    height: 22px;
    margin: 0;
    accent-color: var(--accent-strong);
  }
  .check a {
    color: var(--accent-strong);
  }
  .field__error {
    color: #b00020;
    font-size: var(--fs-body-sm);
    font-weight: 700;
  }
  .field__error[hidden] {
    display: none;
  }
  .newsletter button {
    justify-self: start;
  }
  .newsletter__status:empty {
    display: none;
  }
  .newsletter__status {
    padding: 12px 16px;
    border-radius: var(--r-sm);
    font-weight: 700;
  }
  .newsletter[data-state='success'] .newsletter__status {
    background: #e6f4ea;
    color: #0b5a23;
  }
  .newsletter[data-state='error'] .newsletter__status {
    background: #fde8ec;
    color: #8a0019;
  }
  .newsletter[data-state='sending'] .newsletter__status {
    background: var(--surface);
    color: var(--ink-muted);
  }
  @media (max-width: 899px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
