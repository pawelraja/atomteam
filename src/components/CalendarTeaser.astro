---
// Calendar teaser: the next four months that still have races, in columns (before the season,
// simply its first four months). Month-only (TBC) entries show a dashed "date TBC" chip.
import { anchor } from '../lib/anchors';
import { getData } from '../lib/data';
import { copy, fill, typo, type Lang } from '../lib/i18n';
import { route } from '../lib/routes';
import { formatRange, monthLabel, raceLocation, raceName, type RaceEvent } from '../lib/season';
import { teaserMonths } from '../lib/showcase';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { site, calendars, today } = getData();
const t = copy(lang);
const tt = t.teaser;
const season = site.currentSeason;
const PER_MONTH = 3;
const months = teaserMonths(calendars.get(season) ?? [], today).map((m) => ({
  ...m,
  shown: m.events.slice(0, PER_MONTH),
  more: Math.max(0, m.events.length - PER_MONTH),
}));
const pad = (n: number) => String(n).padStart(2, '0');
// "Tychy · przełaj", "CRO · 1.2": the place (or country), then the class (or the discipline).
const meta = (e: RaceEvent) =>
  [raceLocation(e, lang) ?? e.country, e.cls && e.cls !== 'Nat.' ? e.cls : t.numbers.disciplineNames[e.discipline]].join(' · ');
---

<section class="teaser" id={anchor(lang, 'calendar')} data-section="calendar" aria-labelledby="teaser-title">
  <div class="container teaser__inner">
    <div class="teaser__head">
      <div class="teaser__title">
        <p class="eyebrow">{site.calendarConfirmed ? tt.eyebrow : tt.eyebrowProvisional}</p>
        <h2 id="teaser-title" class="chapter">{fill(tt.title, { season }, lang)}</h2>
      </div>
      <div class="teaser__actions">
        {months.length > 0 && !site.calendarConfirmed && <p class="teaser__note">{tt.provisional}</p>}
        <a class="btn btn--secondary" href={route(lang, 'calendar')}>{tt.fullCalendar}</a>
      </div>
    </div>

    {months.length === 0 && <p class="teaser__note">{fill(tt.complete, { season }, lang)}</p>}

    {
      months.length > 0 && (
        <ol class="months" role="list">
          {months.map((m) => (
            <li class="month">
              <h3 class="month__label">{monthLabel(m.month, t.meta.locale)}</h3>
              <ol class="races" role="list">
                {m.shown.map((e) => (
                  <li class:list={['race', { 'race--next': e.id === m.nextId }]}>
                    <span class:list={['race__name', { strike: e.status === 'cancelled' }]}>{typo(lang, raceName(e, lang))}</span>
                    <span class="race__meta">
                      {e.start && e.end ? (
                        <span class="race__date">{formatRange(e.start, e.end, t.meta.locale)}</span>
                      ) : (
                        <span class="chip-tbc">{tt.tbc}</span>
                      )}
                      {e.id === m.nextId && <span class="chip-next">{tt.next}</span>}
                      {e.status === 'cancelled' && <span class="chip-tbc">{t.calendar.status.cancelled}</span>}
                      {meta(e)}
                    </span>
                  </li>
                ))}
              </ol>
              {m.more > 0 && (
                <a class="month__more" href={`${route(lang, 'calendar')}#${anchor(lang, 'calendar')}-${season}-${pad(m.month)}`}>
                  {fill(tt.more, { n: m.more }, lang)}
                </a>
              )}
            </li>
          ))}
        </ol>
      )
    }
  </div>
</section>

<style>
  .teaser {
    padding-block: 120px;
  }
  .teaser__inner {
    display: grid;
    gap: 40px;
  }
  .teaser__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    flex-wrap: wrap;
  }
  .teaser__title {
    display: grid;
    gap: 16px;
  }
  .teaser__actions {
    display: flex;
    align-items: center;
    gap: 12px 16px;
    flex-wrap: wrap;
  }
  .teaser__note {
    font-size: 14px;
    color: var(--ink-muted);
  }
  .teaser .btn--secondary {
    font-weight: 400;
  }
  .months {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }
  .month {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 16px;
    border-top: 2px solid var(--line);
  }
  .month__label {
    font-size: 22px;
    line-height: 28px;
  }
  .races {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .race {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-bottom: 12px;
    border-bottom: 1px solid #e4e0e6;
  }
  .race__name {
    font-size: 15px;
    line-height: 1.4;
  }
  .race__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
    align-items: center;
    font-size: 13px;
    line-height: 1.3;
    color: var(--ink-muted);
  }
  .race__date {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .chip-tbc,
  .chip-next {
    padding: 1px 8px;
    border-radius: var(--r-pill);
    border: 1px dashed var(--ink-subtle);
    font-size: 12px;
  }
  .chip-next {
    border: 1px solid var(--accent);
    background: var(--accent);
    color: var(--ink-on-accent);
    font-weight: 700;
  }
  .strike {
    text-decoration: line-through;
  }
  .month__more {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    font-size: 14px;
  }
  @media (max-width: 1023px) {
    .months {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 40px;
    }
  }
  @media (max-width: 599px) {
    .teaser {
      padding-block: 64px;
    }
    .months {
      grid-template-columns: 1fr;
    }
  }
</style>
