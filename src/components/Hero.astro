---
// Home hero. Evergreen by design: nothing here changes with the season except the year in the
// partner button. Seasonal news lives in the status bar.
import { anchor } from '../lib/anchors';
import { getData } from '../lib/data';
import { HERO_DESKTOP_MEDIA, HERO_MOBILE_MEDIA, heroSources } from '../lib/hero';
import { copy, fill, type Lang } from '../lib/i18n';
import { route } from '../lib/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { site } = getData();
const t = copy(lang);
const { desktop, mobile } = await heroSources();
const c = t.hero.credentials;
const credentials = [
  { ...c.licence, mobile: true },
  { ...c.juniors, mobile: false },
  { ...c.base, mobile: false },
  { ...c.founded, mobile: true },
  { ...c.programme, mobile: true },
].map((x) => ({ ...x, value: fill(x.value, { founded: site.foundedYear }, lang) }));
---

<section class="hero" id={anchor(lang, 'top')} data-section="top" data-theme="dark" aria-labelledby="hero-title">
  <div class="hero__media">
    {
      desktop || mobile ? (
        <picture>
          {mobile && <source media={HERO_MOBILE_MEDIA} srcset={mobile.srcset} sizes="100vw" width={mobile.width} height={mobile.height} type="image/webp" />}
          {desktop && <source media={HERO_DESKTOP_MEDIA} srcset={desktop.srcset} sizes="100vw" width={desktop.width} height={desktop.height} type="image/webp" />}
          <img
            src={(desktop ?? mobile)!.src}
            alt={t.hero.alt}
            width={(desktop ?? mobile)!.width}
            height={(desktop ?? mobile)!.height}
            fetchpriority="high"
            loading="eager"
            decoding="sync"
          />
        </picture>
      ) : (
        <div class="hero__ph" role="img" aria-label={fill(t.a11y.photoPlaceholder, { alt: t.hero.alt })} data-placeholder="photos/hero.jpg">
          <span class="hero__ph-label" aria-hidden="true">hero.jpg · 16:9 · hero-mobile.jpg · 4:5</span>
        </div>
      )
    }
  </div>

  <div class="hero__content container">
    <p class="hero__eyebrow">{t.hero.eyebrow}</p>
    <h1 id="hero-title">{t.hero.title}</h1>
    <div class="hero__row">
      <p class="hero__mission">{fill(t.hero.mission, { founded: site.foundedYear }, lang)}</p>
      <div class="hero__buttons">
        <a class="btn btn--secondary hero__secondary" href={route(lang, 'team')}>{t.hero.secondary}</a>
        <a class="btn btn--primary" href={`${route(lang, 'partners')}#${anchor(lang, 'cta')}`}>{fill(t.hero.primary, { season: site.currentSeason }, lang)}</a>
      </div>
    </div>
    <dl class="credentials" aria-label={t.hero.credentialsLabel}>
      {
        credentials.map((x) => (
          <div class:list={{ 'desk-only': !x.mobile }}>
            <dt>{x.term}</dt>
            <dd>{x.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: min(calc(100svh - var(--status-h)), 820px);
    background: #3f273c;
    color: var(--ink);
    isolation: isolate;
    overflow: hidden;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__media picture,
  .hero__media img,
  .hero__ph {
    width: 100%;
    height: 100%;
  }
  .hero__media img {
    object-fit: cover;
  }
  /* Plum scrim: keeps the copy at 4.5:1+ over the lightest part of any photo. */
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(43, 0, 32, 0.15) 0, rgba(43, 0, 32, 0.35) 35%, rgba(43, 0, 32, 0.9) 70%);
  }
  .hero__ph {
    position: relative;
    background: #3f273c;
  }
  .hero__ph-label {
    position: absolute;
    right: 32px;
    top: 104px;
    padding: 6px 12px;
    border-radius: var(--r-pill);
    background: rgba(0, 0, 0, 0.35);
    color: #f1eef3;
    font-size: 12px;
  }
  .hero__content {
    display: grid;
    gap: 28px;
    padding-top: calc(var(--header-h) + 96px);
  }
  .hero__eyebrow {
    font-size: 14px;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
  }
  h1 {
    max-width: 1180px;
    font-size: var(--fs-hero);
    line-height: var(--lh-hero);
    letter-spacing: var(--ls-hero);
    text-wrap: balance;
  }
  .hero__row {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--s-4) 48px;
  }
  .hero__mission {
    max-width: 560px;
    font-size: 20px;
    line-height: 1.4;
    color: var(--ink-muted);
  }
  .hero__buttons {
    display: flex;
    gap: 12px;
    flex: none;
  }
  .hero__secondary {
    color: var(--ink);
    font-weight: 400;
  }

  /* Credential strip */
  .credentials {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-top: 20px;
    border-top: 1px solid rgba(241, 238, 243, 0.28);
  }
  .credentials div {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 20px 20px 28px;
  }
  .credentials div:first-child {
    padding-left: 0;
  }
  .credentials div + div {
    border-left: 1px solid rgba(241, 238, 243, 0.28);
  }
  dt {
    font-size: 12px;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  dd {
    font-size: 18px;
    color: var(--ink);
  }
  @media (max-width: 1023px) {
    .hero__row {
      flex-direction: column;
      align-items: start;
    }
  }
  @media (max-width: 699px) {
    .hero__content {
      gap: 18px;
      padding-top: calc(var(--header-h) + 64px);
    }
    .hero__eyebrow {
      font-size: 12px;
    }
    .hero__mission {
      font-size: 16px;
    }
    .hero__buttons {
      flex-direction: column-reverse;
      align-self: stretch;
      gap: 10px;
    }
    .credentials {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-top: 0;
    }
    .credentials .desk-only {
      display: none;
    }
    .credentials div {
      padding: 14px 0 20px 12px;
    }
    .credentials div:nth-child(1) {
      padding-left: 0;
    }
    /* Terms stay for screen readers; phones show the values only. */
    dt {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    dd {
      font-size: 14px;
    }
  }
</style>
