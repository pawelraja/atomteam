---
// Home hero. Evergreen by design: nothing here changes with the season except the year in the
// partner button. Seasonal news lives in the status bar.
import { anchor } from '../lib/anchors';
import { getData } from '../lib/data';
import { HERO_DESKTOP_MEDIA, HERO_MOBILE_MEDIA, heroSources } from '../lib/hero';
import { copy, fill, type Lang } from '../lib/i18n';
import { route } from '../lib/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { site } = getData();
const t = copy(lang);
const { desktop, mobile } = await heroSources();
const c = t.hero.credentials;
const credentials = [c.licence, c.juniors, c.base, c.founded, c.programme].map((x) => ({
  term: x.term,
  value: fill(x.value, { founded: site.foundedYear }, lang),
}));
---

<section class="hero" id={anchor(lang, 'top')} data-section="top" aria-labelledby="hero-title">
  <div class="hero__media">
    {
      desktop || mobile ? (
        <picture>
          {mobile && <source media={HERO_MOBILE_MEDIA} srcset={mobile.srcset} sizes="100vw" width={mobile.width} height={mobile.height} type="image/webp" />}
          {desktop && <source media={HERO_DESKTOP_MEDIA} srcset={desktop.srcset} sizes="100vw" width={desktop.width} height={desktop.height} type="image/webp" />}
          <img
            src={(desktop ?? mobile)!.src}
            alt={t.hero.alt}
            width={(desktop ?? mobile)!.width}
            height={(desktop ?? mobile)!.height}
            fetchpriority="high"
            loading="eager"
            decoding="sync"
          />
        </picture>
      ) : (
        <div class="ph hero__ph" role="img" aria-label={fill(t.a11y.photoPlaceholder, { alt: t.hero.alt })} data-placeholder="photos/hero.jpg">
          <span class="ph__label" aria-hidden="true">
            <span class="ph__file">photos/hero.jpg · 16:9</span>
            <span>photos/hero-mobile.jpg · 4:5</span>
          </span>
        </div>
      )
    }
  </div>

  <div class="hero__band" data-theme="dark">
    <div class="hero__content container">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1 id="hero-title">{t.hero.title}</h1>
      <p class="hero__mission">{t.hero.mission}</p>
      <div class="btn-row">
        <a class="btn btn--secondary hero__secondary" href={route(lang, 'team')}>{t.hero.secondary}</a>
        <a class="btn btn--primary" href={`${route(lang, 'partners')}#${anchor(lang, 'cta')}`}>{fill(t.hero.primary, { season: site.currentSeason }, lang)}</a>
      </div>
    </div>

    <div class="container">
      <dl class="credentials" aria-label={t.hero.credentialsLabel}>
        {
          credentials.map((x) => (
            <div>
              <dt>{x.term}</dt>
              <dd>{x.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: min(calc(100svh - var(--status-h)), 1000px);
    background: #2b0020;
    color: #f1eef3;
    isolation: isolate;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__media picture,
  .hero__media img,
  .hero__ph {
    width: 100%;
    height: 100%;
  }
  .hero__media img {
    object-fit: cover;
  }
  .hero__ph {
    align-items: start;
    padding-top: 120px;
  }
  /* Scrim: a fade into a plum wash behind the copy, so text stays readable on any photo. */
  .hero__band {
    align-self: end;
    position: relative;
    padding-top: calc(var(--header-h) + 48px);
    background: transparent;
  }
  .hero__band::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to bottom, rgba(43, 0, 32, 0) 0, rgba(43, 0, 32, 0.88) 180px);
  }
  .hero__content {
    display: grid;
    justify-items: start;
    gap: var(--s-4);
    padding-bottom: clamp(40px, 6vw, 72px);
    color: var(--ink);
  }
  h1 {
    max-width: 11ch;
    font-size: var(--fs-hero);
    line-height: var(--lh-hero);
    letter-spacing: var(--ls-hero);
    text-wrap: balance;
  }
  .hero__mission {
    font-size: var(--fs-body-lg);
    max-width: 46ch;
    color: var(--ink-muted);
  }
  .hero__secondary {
    color: var(--ink);
  }
  .btn-row {
    margin-top: var(--s-2);
  }

  /* Credential strip */
  .credentials {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--s-3);
    padding-block: var(--s-4) var(--s-5);
    border-top: 1px solid var(--line);
  }
  .credentials div {
    display: grid;
    gap: 2px;
  }
  dt {
    font-size: var(--fs-eyebrow);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent);
  }
  dd {
    font-size: var(--fs-body);
    color: var(--ink);
  }
  @media (max-width: 899px) {
    .credentials {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: var(--s-4);
    }
  }
  @media (max-width: 479px) {
    .btn-row {
      flex-direction: column;
      align-self: stretch;
    }
    .credentials {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
