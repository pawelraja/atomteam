---
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import Social from './Social.astro';
import { anchor } from '../lib/anchors';
import { copy, type Lang } from '../lib/i18n';
import { brandLogoExists } from '../lib/images';
import { route, type PageKey } from '../lib/routes';

interface Props {
  lang: Lang;
  page: PageKey;
  /** This page in each language, for the language switch. */
  paths: Record<Lang, string>;
}
const { lang, page, paths } = Astro.props;
const t = copy(lang);
const nav = [
  { key: 'team', href: route(lang, 'team'), label: t.nav.team },
  { key: 'calendar', href: route(lang, 'calendar'), label: t.nav.calendar },
  { key: 'partners', href: route(lang, 'partners'), label: t.nav.partners },
  { key: 'media', href: route(lang, 'media'), label: t.nav.media },
  { key: 'contact', href: `#${anchor(lang, 'contact')}`, label: t.nav.contact },
];
const current = (key: string) => (key === page ? 'page' : undefined);
const ctaHref = `${route(lang, 'partners')}#${anchor(lang, 'cta')}`;
// Drop the official logo at public/brand/logo.svg and it replaces the text wordmark.
const hasLogo = brandLogoExists();
---

<header class="site-header">
  <div class="bar">
    <a class="wordmark" href={route(lang, 'home')} aria-label={t.a11y.home} aria-current={current('home')}>
      {
        hasLogo ? (
          <img src="/brand/logo.svg" alt="" width="180" height="40" />
        ) : (
          <span aria-hidden="true">
            {t.team.wordmarkA} <strong>{t.team.wordmarkB}</strong>
          </span>
        )
      }
    </a>

    <nav class="nav" aria-label={t.a11y.mainNav}>
      <ul role="list">
        {nav.map((n) => <li><a href={n.href} aria-current={current(n.key)}>{n.label}</a></li>)}
      </ul>
    </nav>

    <div class="end">
      <LangSwitch lang={lang} paths={paths} class="desk-only" />
      <Social lang={lang} class="header-social desk-only" />
      <a class="btn btn--primary cta desk-only" href={ctaHref}>{t.nav.cta}</a>
      <LangSwitch lang={lang} paths={paths} variant="single" class="mobile-only" />
      <button class="burger mobile-only" type="button" aria-haspopup="dialog" aria-controls="mobile-menu" aria-expanded="false" data-menu-open>
        <Icon name="menu" />
        <span class="visually-hidden">{t.a11y.openMenu}</span>
      </button>
    </div>
  </div>
</header>

<dialog id="mobile-menu" class="menu" data-theme="dark" aria-label={t.a11y.mainNav}>
  <div class="menu__top">
    <span class="wordmark" aria-hidden="true">{t.team.wordmarkA} <strong>{t.team.wordmarkB}</strong></span>
    <button class="burger burger--close" type="button" data-menu-close>
      <Icon name="close" />
      <span class="visually-hidden">{t.a11y.closeMenu}</span>
    </button>
  </div>
  <nav aria-label={t.a11y.mainNav}>
    <ul role="list" class="menu__list">
      <li><a href={route(lang, 'home')} data-menu-link aria-current={current('home')}>{t.nav.home}</a></li>
      {nav.map((n) => <li><a href={n.href} data-menu-link aria-current={current(n.key)}>{n.label}</a></li>)}
    </ul>
  </nav>
  <div class="menu__foot">
    <a class="btn btn--primary" href={ctaHref} data-menu-link>{t.nav.cta}</a>
    <Social lang={lang} size={26} />
  </div>
</dialog>

<script>
  import { ANCHORS, type AnchorKey } from '../lib/anchors';
  import type { Lang } from '../lib/text';

  const menu = document.getElementById('mobile-menu') as HTMLDialogElement;
  const opener = document.querySelector<HTMLButtonElement>('[data-menu-open]')!;
  opener.addEventListener('click', () => {
    menu.showModal();
    opener.setAttribute('aria-expanded', 'true');
  });
  menu.addEventListener('close', () => opener.setAttribute('aria-expanded', 'false'));
  menu.querySelector('[data-menu-close]')!.addEventListener('click', () => menu.close());
  menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => menu.close()));
  matchMedia('(min-width: 1180px)').addEventListener('change', (e) => e.matches && menu.open && menu.close());

  // Keep the language links pointing at the section currently on screen, on the same page.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-lang-link]')];
  const sections = [...document.querySelectorAll<HTMLElement>('[data-section]')];
  const setTarget = (key: AnchorKey) => {
    for (const a of links) {
      const hash = ANCHORS[a.dataset.langLink as Lang][key];
      if (hash) a.href = `${a.dataset.langBase}#${hash}`;
    }
  };
  if (links.length && sections.length && 'IntersectionObserver' in window) {
    const visible = new Map<HTMLElement, number>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) visible.set(e.target as HTMLElement, e.intersectionRatio);
        const best = [...visible].filter(([, r]) => r > 0).sort((a, b) => b[1] - a[1])[0];
        if (best) setTarget(best[0].dataset.section as AnchorKey);
      },
      { rootMargin: '-35% 0px -55% 0px', threshold: [0, 0.01, 0.5, 1] },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>

<style>
  /* Floats over the page: sticks 16px from the top; its own height is taken back with a
     negative margin so the hero / page intro runs underneath it. */
  .site-header {
    position: sticky;
    top: 16px;
    z-index: 50;
    margin: 16px 16px calc(-1 * (var(--header-h) + 16px));
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    height: var(--header-h);
    padding: 0 8px 0 28px;
    border-radius: var(--r-feature);
    background: var(--header-glass);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    backdrop-filter: blur(16px) saturate(1.4);
    color: #000;
  }
  .wordmark {
    flex: none;
    color: inherit;
    text-decoration: none;
    font-size: 15px;
    letter-spacing: 0.02em;
    line-height: 1.1;
    white-space: nowrap;
  }
  .wordmark strong {
    font-weight: 700;
  }
  .nav {
    margin-inline: auto;
  }
  .nav ul {
    display: flex;
    gap: var(--s-1);
  }
  .nav a {
    display: block;
    padding: 10px 14px;
    border-radius: var(--r-pill);
    text-decoration: none;
  }
  .nav a:hover {
    color: #000;
    background: rgba(255, 102, 237, 0.25);
  }
  .nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--accent-strong);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  .end {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin-left: auto;
  }
  .cta {
    min-height: 48px;
    padding-inline: 22px;
    white-space: nowrap;
  }
  .burger {
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: var(--r-pill);
    background: var(--accent);
    color: var(--ink-on-accent);
    cursor: pointer;
  }
  .end :global(.mobile-only) {
    display: none;
  }

  @media (max-width: 1439px) {
    .end :global(.header-social) {
      display: none;
    }
  }
  @media (max-width: 1179px) {
    .nav,
    .end :global(.desk-only) {
      display: none;
    }
    .end :global(.mobile-only) {
      display: grid;
    }
    .bar {
      padding-left: 20px;
    }
  }
  @media (max-width: 400px) {
    .wordmark {
      font-size: 13px;
      white-space: normal;
      max-width: 170px;
    }
  }

  /* Full-screen plum menu */
  .menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 16px;
    border: 0;
    background: var(--surface);
    color: var(--ink);
  }
  .menu[open] {
    display: flex;
    flex-direction: column;
  }
  .menu::backdrop {
    background: #2b0020;
  }
  .menu .burger {
    display: grid;
  }
  .menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    padding: 0 8px 0 20px;
  }
  .menu__list {
    display: grid;
    gap: var(--s-1);
    padding: var(--s-5) 20px;
  }
  .menu__list a {
    display: inline-block;
    padding-block: 4px;
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
    text-decoration: none;
  }
  .menu__list a:hover,
  .menu__list a[aria-current='page'] {
    color: var(--accent);
  }
  .menu__foot {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    padding: 20px;
  }
</style>
