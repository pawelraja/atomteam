---
import { anchor } from '../lib/anchors';
import { getData } from '../lib/data';
import { copy, fill, plural, type Lang } from '../lib/i18n';
import { pickRoster, seasonNumber } from '../lib/season';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { site, riders } = getData();
const t = copy(lang);
const g = t.glance;
const season = site.currentSeason;
const roster = pickRoster(riders, season);
// A rider count is only shown once the current roster is confirmed.
const showCount = site.rosterConfirmed && roster.isCurrent && roster.items.length > 0;

const facts = [
  { value: fill(g.since.value, { founded: site.foundedYear }, lang), label: fill(g.since.label, { number: seasonNumber(site), season }, lang) },
  showCount
    ? { value: plural(g.riders.value, roster.items.length, lang), label: g.riders.label }
    : { value: g.ridersUnconfirmed.value, label: fill(g.ridersUnconfirmed.label, { season }, lang) },
  { value: g.level.value, label: g.level.label },
  { value: g.clubPro.value, label: g.clubPro.label },
];
---

<section class="section section--alt glance" id={anchor(lang, 'glance')} data-section="glance" aria-labelledby="glance-title">
  <div class="container">
    <h2 id="glance-title" class="visually-hidden">{g.title}</h2>
    <dl class="facts">
      {
        facts.map((f) => (
          <div class="fact">
            <dt class="fact__label">{f.label}</dt>
            <dd class="fact__value">{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .glance {
    padding-block: clamp(40px, 5vw, 72px);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-5);
  }
  .fact {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--s-2);
    padding-top: var(--s-3);
    border-top: 2px solid var(--accent);
  }
  .fact__value {
    font-size: clamp(24px, 2.5vw, 34px);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .fact__label {
    font-size: var(--fs-body-sm);
    color: var(--ink-muted);
  }
  @media (max-width: 1023px) {
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s-4);
    }
  }
  /* Values like "20 zawodniczek" are bound by a non-breaking space: one column on narrow phones. */
  @media (max-width: 439px) {
    .facts {
      grid-template-columns: 1fr;
      gap: var(--s-3);
    }
  }
</style>
