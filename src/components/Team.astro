---
// Team tabs: Continental / Juniors / Staff. Shows current-season riders as soon as any are
// listed (with an "announced at the presentation" note until rosterConfirmed); otherwise the
// latest roster, labelled with its season.
import { anchor } from '../lib/anchors';
import { getData } from '../lib/data';
import { copy, fill, pick, type Lang } from '../lib/i18n';
import { riderPath, route } from '../lib/routes';
import { riderSlug } from '../lib/showcase';
import { teamView } from '../lib/view';
import Icon from './Icon.astro';
import PersonCard from './PersonCard.astro';

interface Props {
  lang: Lang;
  /** "home" adds a link to the team page; "page" uses an h2 below the page intro. */
  variant?: 'home' | 'page';
}
const { lang, variant = 'home' } = Astro.props;
const { site } = getData();
const t = copy(lang);
const ts = t.teamSection;
const season = site.currentSeason;
const { roster, crew } = teamView();
const shownSeason = roster.season ?? season;
const countries = t.calendar.countryNames as Record<string, string>;

let note: string | null = null;
if (!roster.isCurrent) note = fill(ts.fallbackNote, { next: season }, lang);
else if (!site.rosterConfirmed) note = fill(ts.provisionalNote, { season }, lang);

const squads = [
  { id: 'continental', label: ts.tabs.continental, people: roster.items.filter((r) => r.squad === 'continental') },
  { id: 'junior', label: ts.tabs.junior, people: roster.items.filter((r) => r.squad === 'junior') },
] as const;
---

<section class="team" id={anchor(lang, 'team')} data-section="team" aria-labelledby="team-title">
  <div class="container team__inner">
    <div class="team__head">
      <div class="team__title">
        <p class="eyebrow">{fill(ts.eyebrow, { season: shownSeason }, lang)}</p>
        <h2 id="team-title" class="chapter">{ts.title}</h2>
        {note && <p class="team__note">{note}</p>}
      </div>
      <div class="tablist" role="tablist" aria-label={ts.tabsLabel} data-tabs>
        {
          [...squads, { id: 'staff', label: ts.tabs.staff }].map((s, i) => (
            <button
              class="tab"
              type="button"
              role="tab"
              id={`tab-${s.id}`}
              aria-controls={`panel-${s.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              {s.label}
            </button>
          ))
        }
      </div>
    </div>

    {
      squads.map((s, i) => (
        <div class="panel" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} tabindex="0" hidden={i !== 0}>
          {s.id === 'junior' && <p class="team__junior">{ts.juniorIntro}</p>}
          {s.people.length ? (
            <ul class="grid" role="list">
              {s.people.map((r) => (
                <li>
                  <PersonCard
                    lang={lang}
                    name={r.name}
                    chip={r.nat}
                    chipLabel={countries[r.nat] ?? r.nat}
                    role={r.role ? pick(lang, r.role) : ts.roles[r.squad]}
                    photo={r.photo}
                    href={riderPath(lang, riderSlug(r))}
                    linkLabel={ts.profileLink}
                    isNew={roster.isCurrent && r.new ? fill(ts.newPill, { season }, lang) : null}
                  />
                </li>
              ))}
            </ul>
          ) : (
            <p class="muted">{ts.emptySquad}</p>
          )}
        </div>
      ))
    }

    <div class="panel" role="tabpanel" id="panel-staff" aria-labelledby="tab-staff" tabindex="0" hidden>
      <ul class="grid" role="list">
        {
          crew.items.map((s) => (
            <li>
              <PersonCard lang={lang} name={s.name} chip={ts.staffChip} role={pick(lang, s.role)} photo={s.photo} />
            </li>
          ))
        }
      </ul>
    </div>

    {
      variant === 'home' && (
        <p>
          <a class="text-link" href={route(lang, 'team')}>
            {ts.allRiders} <Icon name="arrow" size={18} />
          </a>
        </p>
      )
    }
  </div>
  <noscript><style>.team .panel[hidden] { display: block !important; } .team .tablist { display: none; }</style></noscript>
</section>

<script>
  import { initTabs } from './Tabs';
  document.querySelectorAll<HTMLElement>('.team').forEach((section) => {
    const list = section.querySelector<HTMLElement>('[data-tabs]');
    if (list) initTabs(list);
  });
</script>

<style>
  .team {
    padding-block: 120px;
    background: var(--surface-alt);
  }
  .team__inner {
    display: grid;
    gap: 48px;
  }
  .team__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    flex-wrap: wrap;
  }
  .team__title {
    display: grid;
    gap: 16px;
  }
  .team__note {
    font-size: 17px;
    line-height: 1.47;
    color: var(--ink-muted);
  }
  .tablist {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .tab {
    min-height: 44px;
    padding: 9px 18px;
    border: 1px solid var(--accent);
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--accent-strong);
    font: 400 14px / 1.4 var(--font);
    cursor: pointer;
  }
  .tab:hover {
    background: color-mix(in srgb, var(--accent) 20%, transparent);
  }
  .tab[aria-selected='true'] {
    background: var(--accent);
    color: var(--ink-on-accent);
  }
  .team__junior {
    margin-bottom: 32px;
    font-size: 22px;
    line-height: 1.4;
    font-weight: 700;
    color: var(--accent-strong);
  }
  .panel:focus-visible {
    outline-offset: 8px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px 24px;
  }
  .grid > li {
    display: grid;
  }
  @media (max-width: 899px) {
    .team {
      padding-block: 64px;
    }
    .team__inner {
      gap: 32px;
    }
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 599px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px 12px;
    }
    .team__junior {
      font-size: 18px;
    }
  }
</style>
