---
// The one-page site. Section order comes from site.json "phase" (see sectionOrder()).
import Base from '../layouts/Base.astro';
import Calendar from './Calendar.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import Glance from './Glance.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Movement from './Movement.astro';
import NextRace from './NextRace.astro';
import Partners from './Partners.astro';
import Presentation from './Presentation.astro';
import Recap from './Recap.astro';
import Story from './Story.astro';
import Team from './Team.astro';
import { getData } from '../lib/data';
import type { Lang } from '../lib/i18n';
import { sectionOrder, type SectionId } from '../lib/season';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { site } = getData();
const sections: Partial<Record<SectionId, any>> = {
  presentation: Presentation,
  glance: Glance,
  recap: Recap,
  'next-race': NextRace,
  story: Story,
  team: Team,
  calendar: Calendar,
  partners: Partners,
  movement: Movement,
  contact: Contact,
};
const order = sectionOrder(site.phase).filter((id) => sections[id]);
---

<Base lang={lang}>
  <Header lang={lang} />
  <main id="main" tabindex="-1">
    <Hero lang={lang} />
    {order.map((id) => { const Section = sections[id]; return <Section lang={lang} />; })}
  </main>
  <Footer lang={lang} />
</Base>
