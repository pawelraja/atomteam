---
// "Your brand in the peloton": a numbered jersey diagram (inline SVG) with a matching numbered
// list, including "+ Beyond the kit". Field names and texts come from copy.*.json.
import { anchor } from '../lib/anchors';
import { copy, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy(lang);
const tb = t.brand;
// Marker positions on the drawing (viewBox 380 × 340), keyed by field number.
const markers: [string, number, number][] = [
  ['1', 190, 126],
  ['2', 66, 72],
  ['2', 314, 72],
  ['3', 190, 249],
];
---

<section class="brand" id={anchor(lang, 'brand')} data-section="brand" aria-labelledby="brand-title">
  <div class="container brand__inner">
    <div class="brand__head">
      <div class="brand__title">
        <p class="eyebrow">{tb.eyebrow}</p>
        <h2 id="brand-title" class="chapter">{tb.title}</h2>
      </div>
      <p class="brand__lead">{tb.lead}</p>
    </div>

    <div class="brand__body">
      <figure class="diagram">
        <svg viewBox="0 0 380 340" role="img" aria-labelledby="jersey-title" xmlns="http://www.w3.org/2000/svg">
          <title id="jersey-title">{tb.diagramLabel}</title>
          <path
            d="M140 24 L100 36 L28 84 L58 150 L92 134 L92 316 L288 316 L288 134 L322 150 L352 84 L280 36 L240 24 Q190 64 140 24 Z"
            fill="#f1eef3"
            stroke="#2b0020"
            stroke-width="2"
            stroke-linejoin="round"></path>
          <rect x="140" y="104" width="100" height="44" rx="6" fill="#ff66ed"></rect>
          <rect x="44" y="92" width="44" height="22" rx="4" fill="#d9aaff" transform="rotate(-28 66 103)"></rect>
          <rect x="292" y="92" width="44" height="22" rx="4" fill="#d9aaff" transform="rotate(28 314 103)"></rect>
          <rect x="112" y="236" width="156" height="26" rx="4" fill="#c580ff"></rect>
          {
            markers.map(([n, x, y]) => (
              <g>
                <circle cx={x} cy={y} r="13" fill="#2b0020"></circle>
                <text x={x} y={y + 5} text-anchor="middle" font-size="14" font-weight="700" fill="#ffffff" font-family="Inter, sans-serif">
                  {n}
                </text>
              </g>
            ))
          }
        </svg>
        <figcaption>{tb.caption}</figcaption>
      </figure>

      <ol class="fields" role="list">
        {
          tb.fields.map((f) => (
            <li class="field">
              <span class="field__n" aria-hidden="true">{f.n}</span>
              <div class="field__text">
                <h3 class="field__title">
                  {f.n !== '+' && <span class="visually-hidden">{f.n}. </span>}
                  {f.title}
                </h3>
                <p>{f.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .brand {
    padding-block: 120px;
    background: var(--surface-alt);
  }
  .brand__inner {
    display: grid;
    gap: 64px;
  }
  .brand__head,
  .brand__body {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--grid-gap);
    align-items: end;
  }
  .brand__body {
    align-items: center;
  }
  .brand__title {
    grid-column: span 7;
    display: grid;
    gap: 16px;
  }
  .brand__lead {
    grid-column: 9 / span 4;
    font-size: 17px;
    line-height: 1.47;
    color: var(--ink-muted);
  }
  .diagram {
    grid-column: span 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 40px;
    border-radius: var(--r-feature);
    background: #ffffff;
  }
  .diagram svg {
    width: 100%;
    max-width: 380px;
    height: auto;
  }
  figcaption {
    font-size: 12px;
    line-height: 1.4;
    color: var(--ink-muted);
    text-align: center;
  }
  .fields {
    grid-column: 7 / span 6;
  }
  .field {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid #c0b8be;
  }
  .field__n {
    font-size: 15px;
    font-weight: 700;
    color: var(--accent-strong);
  }
  .field__text {
    display: grid;
    gap: 2px;
  }
  .field__title {
    font-size: 20px;
    line-height: 28px;
  }
  .field__text p {
    font-size: 14px;
    line-height: 1.4;
    color: var(--ink-muted);
  }
  @media (max-width: 899px) {
    .brand {
      padding-block: 64px;
    }
    .brand__inner {
      gap: 28px;
    }
    .brand__head,
    .brand__body {
      grid-template-columns: 1fr;
    }
    .brand__title,
    .brand__lead,
    .diagram,
    .fields {
      grid-column: auto;
    }
    .diagram {
      padding: 20px;
      border-radius: var(--r-card);
    }
    .diagram svg {
      max-width: 260px;
    }
  }
</style>
