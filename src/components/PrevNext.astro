---
// "← Poprzedni wyścig · Następny wyścig →" at the foot of a rider or race page, so a visitor can
// move on without going back to the list. Either side may be missing (first or last item).
import Icon from './Icon.astro';
import { copy, type Lang } from '../lib/i18n';

interface Link {
  href: string;
  name: string;
}
interface Props {
  lang: Lang;
  kind: 'race' | 'rider';
  prev: Link | null;
  next: Link | null;
}
const { lang, kind, prev, next } = Astro.props;
const t = copy(lang).pager;
---

{
  (prev || next) && (
    <nav class="pager container" aria-label={t.label[kind]}>
      {prev ? (
        <a class="pager__link" href={prev.href} rel="prev">
          <span class="pager__dir">
            <span class="back-arrow" aria-hidden="true"><Icon name="arrow" size={16} /></span>
            {t.prev[kind]}
          </span>
          <span class="pager__name">{prev.name}</span>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a class="pager__link pager__link--next" href={next.href} rel="next">
          <span class="pager__dir">
            {t.next[kind]}
            <Icon name="arrow" size={16} />
          </span>
          <span class="pager__name">{next.name}</span>
        </a>
      )}
    </nav>
  )
}

<style>
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    padding-block: 32px 96px;
    border-top: 1px solid var(--line);
  }
  .pager__link {
    display: grid;
    gap: 6px;
    min-height: 48px;
    text-decoration: none;
  }
  .pager__link--next {
    justify-items: end;
    text-align: right;
  }
  .pager__dir {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--accent-strong);
  }
  .back-arrow {
    display: inline-flex;
    transform: scaleX(-1);
  }
  .pager__name {
    font-size: 18px;
    line-height: 1.3;
  }
  .pager__link:hover .pager__name {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  @media (max-width: 599px) {
    .pager {
      gap: 16px;
      padding-bottom: 64px;
    }
    .pager__name {
      font-size: 16px;
    }
  }
</style>
