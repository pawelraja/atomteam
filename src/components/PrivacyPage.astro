---
// Placeholder privacy page, one per language. Replace the copy in copy.*.json → privacyPage.
import { copy, fill, type Lang } from '../lib/i18n';
import { route, ROUTES } from '../lib/routes';
import PageIntro from './PageIntro.astro';
import Shell from './Shell.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy(lang);
---

<Shell lang={lang} page="privacy" paths={ROUTES.privacy} title={`${t.privacyPage.title} — ${t.team.name}`} noindex>
  <PageIntro lang={lang} eyebrow={t.team.name} title={t.privacyPage.title} />
  <section class="privacy">
    <div class="container privacy__inner">
      <p class="body-lg">{fill(t.privacyPage.body, { email: t.team.email }, lang)}</p>
      <p><a class="btn btn--secondary" href={route(lang, 'home')}>{t.privacyPage.back}</a></p>
    </div>
  </section>
</Shell>

<style>
  .privacy {
    padding-block: 64px 96px;
  }
  .privacy__inner {
    display: grid;
    gap: var(--s-5);
    max-width: 760px;
  }
</style>
