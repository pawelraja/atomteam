---
// Placeholder privacy page, one per language. Replace the copy in copy.*.json → privacyPage.
import Base from '../layouts/Base.astro';
import { copy, fill, homePath, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy(lang);
const paths = { pl: '/polityka-prywatnosci/', en: '/en/privacy/' };
---

<Base lang={lang} paths={paths} title={`${t.privacyPage.title} — ${t.team.name}`} jsonLd={false} noindex>
  <main id="main" class="section privacy">
    <div class="container privacy__inner">
      <a class="privacy__home" href={homePath(lang)}>{t.team.wordmarkA} <strong>{t.team.wordmarkB}</strong></a>
      <h1>{t.privacyPage.title}</h1>
      <p class="body-lg">{fill(t.privacyPage.body, { email: t.team.email }, lang)}</p>
      <p><a class="btn btn--secondary" href={homePath(lang)}>{t.privacyPage.back}</a></p>
    </div>
  </main>
</Base>

<style>
  .privacy__inner {
    display: grid;
    gap: var(--s-5);
    max-width: 760px;
  }
  .privacy__home {
    text-decoration: none;
  }
</style>
