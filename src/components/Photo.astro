---
// A photo slot. Renders the image from src/assets/<dir>/<file> as responsive AVIF/WebP,
// or a labelled placeholder when the team has not supplied it yet.
import { Picture } from 'astro:assets';
import { findImage, ratio, type ImageDir } from '../lib/images';
import { copy, fill, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  dir: ImageDir;
  file: string;
  alt: string;
  aspect: '16:9' | '4:5' | '3:4' | '4:3' | '1:1';
  sizes: string;
  widths?: number[];
  eager?: boolean;
  class?: string;
  /** Decorative images (e.g. inside a link that already has a name) pass alt="" and set this. */
  decorative?: boolean;
}

const { lang, dir, file, alt, aspect, sizes, widths = [360, 540, 720, 1080, 1440], eager = false, decorative = false } = Astro.props;
const img = findImage(dir, file);
const t = copy(lang);
const usable = img ? widths.filter((w) => w <= img.width) : [];
if (img && !usable.includes(img.width) && img.width < Math.max(...widths)) usable.push(img.width);
---

{
  img ? (
    <Picture
      src={img}
      alt={decorative ? '' : alt}
      formats={['avif', 'webp']}
      widths={usable}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      decoding={eager ? 'sync' : 'async'}
      fetchpriority={eager ? 'high' : 'auto'}
      pictureAttributes={{ class: ['photo', Astro.props.class].filter(Boolean).join(' '), style: `aspect-ratio:${ratio(aspect)}` }}
    />
  ) : (
    <div
      class:list={['photo', 'ph', Astro.props.class]}
      style={`aspect-ratio:${ratio(aspect)}`}
      role={decorative ? undefined : 'img'}
      aria-label={decorative ? undefined : fill(t.a11y.photoPlaceholder, { alt })}
      aria-hidden={decorative ? 'true' : undefined}
      data-placeholder={`${dir}/${file}`}
    >
      <span class="ph__label" aria-hidden="true">
        <span class="ph__file">{dir}/{file}</span>
        <span>{aspect}</span>
      </span>
    </div>
  )
}

<style>
  .photo {
    display: block;
    width: 100%;
    overflow: hidden;
  }
  .photo :global(img),
  :global(picture.photo) :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
