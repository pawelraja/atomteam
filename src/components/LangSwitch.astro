---
// "PL | EN" segmented control. The active language is a black pill (aria-current); the other is a
// real link to the same section in the other language. Never redirects automatically.
import { copy, LANGS, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  /** The current page in each language. */
  paths: Record<Lang, string>;
  /** "segmented" shows both options; "single" shows only the other language (mobile). */
  variant?: 'segmented' | 'single';
  class?: string;
}
const { lang, paths, variant = 'segmented' } = Astro.props;
const t = copy(lang);
const label = (l: Lang) => copy(l).language.currentShort;
const names: Record<Lang, string> = { pl: 'Polski', en: 'English' };
---

{
  variant === 'segmented' ? (
    <div class:list={['lang-switch', Astro.props.class]} role="group" aria-label={t.language.switchLabel}>
      {LANGS.map((l) =>
        l === lang ? (
          <a class="lang-opt is-current" href={paths[l]} aria-current="page" lang={l} hreflang={l}>
            {label(l)}
            <span class="visually-hidden">, {names[l]}</span>
          </a>
        ) : (
          <a class="lang-opt" href={paths[l]} lang={l} hreflang={l} data-lang-link={l} data-lang-base={paths[l]}>
            {label(l)}
            <span class="visually-hidden">, {names[l]}</span>
          </a>
        ),
      )}
    </div>
  ) : (
    LANGS.filter((l) => l !== lang).map((l) => (
      <a class:list={['lang-single', Astro.props.class]} href={paths[l]} lang={l} hreflang={l} data-lang-link={l} data-lang-base={paths[l]}>
        {label(l)}
        <span class="visually-hidden">, {names[l]}</span>
      </a>
    ))
  )
}

<style>
  .lang-switch {
    display: inline-flex;
    padding: 3px;
    border: 1px solid rgba(0, 0, 0, 0.18);
    border-radius: var(--r-pill);
    gap: 2px;
  }
  .lang-opt,
  .lang-single {
    display: grid;
    place-items: center;
    min-width: 40px;
    height: 36px;
    padding: 0 10px;
    border-radius: var(--r-pill);
    font-size: var(--fs-body-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #000;
    text-decoration: none;
  }
  .lang-opt:not(.is-current):hover {
    background: rgba(255, 102, 237, 0.25);
    color: #000;
  }
  .lang-opt.is-current {
    background: #000;
    color: #fff;
  }
  .lang-single {
    min-width: 44px;
    height: 44px;
  }
</style>
