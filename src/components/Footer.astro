---
// Plum footer on every page: newsletter, team boilerplate, sitemap columns, language, legal.
import { anchor } from '../lib/anchors';
import { getData } from '../lib/data';
import { copy, fill, otherLang, type Lang } from '../lib/i18n';
import { route } from '../lib/routes';
import { resultsView } from '../lib/view';
import NewsletterForm from './NewsletterForm.astro';

interface Props {
  lang: Lang;
  /** The current page in each language, for the language link. */
  paths: Record<Lang, string>;
}
const { lang, paths } = Astro.props;
const { site, today } = getData();
const t = copy(lang);
const tf = t.footer;
const other = otherLang(lang);
const year = today.slice(0, 4);
const home = route(lang, 'home');
const onHome = (key: Parameters<typeof anchor>[1]) => `${home}#${anchor(lang, key)}`;

const columns = [
  {
    title: tf.columns.team,
    links: [
      { href: route(lang, 'team'), label: tf.links.riders },
      { href: onHome('approach'), label: tf.links.approach },
      // Only when the results chapter is on the home page.
      ...(resultsView() ? [{ href: onHome('results'), label: tf.links.results }] : []),
      { href: route(lang, 'calendar'), label: tf.links.calendar },
      { href: route(lang, 'equipment'), label: tf.links.equipment },
      { href: route(lang, 'faq'), label: tf.links.faq },
    ],
  },
  {
    title: tf.columns.collab,
    links: [
      { href: route(lang, 'partners'), label: tf.links.partners },
      { href: route(lang, 'media'), label: tf.links.media },
      { href: onHome('approach'), label: tf.links.clubPro },
    ],
  },
  {
    title: tf.columns.follow,
    external: true,
    links: [
      { href: t.team.social.instagram, label: t.a11y.socialInstagram },
      { href: t.team.social.facebook, label: t.a11y.socialFacebook },
      { href: t.team.social.linkedin, label: t.a11y.socialLinkedin },
    ],
  },
];
---

<footer class="footer" data-theme="dark">
  <div class="container footer__inner">
    <div class="footer__newsletter">
      <div class="footer__intro">
        <h2 id="newsletter-title" class="footer__title">{fill(t.newsletter.title, { season: site.currentSeason }, lang)}</h2>
        <p>{t.newsletter.lead}</p>
      </div>
      <NewsletterForm lang={lang} labelledby="newsletter-title" />
    </div>

    <div class="footer__map">
      <div class="footer__about">
        <p class="footer__wordmark"><strong>{t.team.wordmarkLead}</strong> {t.team.wordmarkA} <strong>{t.team.wordmarkB}</strong></p>
        <p>{fill(tf.boilerplate, { founded: site.foundedYear }, lang)}</p>
        <a class="footer__email" href={`mailto:${t.team.email}`}>{t.team.email}</a>
      </div>
      {
        columns.map((c, i) => (
          <nav class="footer__col" aria-labelledby={`footer-col-${i}`}>
            <h3 class="footer__col-title" id={`footer-col-${i}`}>{c.title}</h3>
            <ul role="list">
              {c.links.map((l) => (
                <li>
                  {c.external ? (
                    <a href={l.href} target="_blank" rel="noopener me">
                      {l.label}
                      <span class="visually-hidden"> {t.a11y.newTab}</span>
                    </a>
                  ) : (
                    <a href={l.href}>{l.label}</a>
                  )}
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="footer__bottom">
      <p>{fill(tf.copyright, { year, team: t.team.name })}</p>
      <ul role="list" class="footer__legal">
        <li>
          <a href={paths[other]} hreflang={other} lang={other} data-lang-link={other} data-lang-base={paths[other]}>
            {t.language.otherVersion}
          </a>
        </li>
        <li><a href={route(lang, 'privacy')}>{tf.privacy}</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--surface-alt);
    padding: 96px 0 40px;
    background: var(--surface);
    color: var(--ink-muted);
  }
  .footer__inner {
    display: grid;
    gap: 72px;
  }
  .footer__newsletter {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--grid-gap);
    align-items: end;
  }
  .footer__intro {
    grid-column: span 6;
    display: grid;
    gap: 12px;
    font-size: 15px;
  }
  .footer__newsletter :global(.newsletter) {
    grid-column: 8 / span 5;
  }
  .footer__title {
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
    color: var(--ink);
  }
  .footer__map {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--grid-gap);
    padding-top: 40px;
    border-top: 1px solid var(--surface-alt);
  }
  .footer__about {
    grid-column: span 4;
    display: grid;
    align-content: start;
    gap: 14px;
    font-size: 14px;
  }
  .footer__wordmark {
    font-size: 15px;
    letter-spacing: 0.02em;
    color: var(--ink);
  }
  .footer__email {
    font-size: 16px;
    color: var(--ink);
  }
  .footer__col {
    grid-column: span 2;
  }
  .footer__col:first-of-type {
    grid-column: 6 / span 2;
  }
  .footer__col-title {
    margin-bottom: 6px;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: #908a8e;
  }
  .footer__col ul {
    display: grid;
  }
  .footer__col a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    font-size: 14px;
    color: var(--ink);
    text-decoration: none;
  }
  .footer__col a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 24px;
    font-size: 13px;
  }
  .footer__legal {
    display: flex;
    gap: 24px;
  }
  .footer__legal a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: var(--ink);
  }
  @media (max-width: 1023px) {
    .footer__intro,
    .footer__newsletter :global(.newsletter) {
      grid-column: 1 / -1;
    }
    .footer__about {
      grid-column: 1 / -1;
    }
    .footer__col,
    .footer__col:first-of-type {
      grid-column: span 4;
    }
  }
  @media (max-width: 599px) {
    .footer {
      padding: 56px 0 32px;
    }
    .footer__inner {
      gap: 48px;
    }
    .footer__col,
    .footer__col:first-of-type {
      grid-column: span 6;
    }
    .footer__title {
      font-size: 30px;
    }
  }
</style>
