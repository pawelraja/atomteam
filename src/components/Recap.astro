---
// Season recap: facts computed from the calendar (only races actually ridden), plus highlight
// cards. Highlights with "verify": true are filtered out (and logged) by the data loader.
import { anchor, seasonAnchor } from '../lib/anchors';
import { copy, fill, pick, plural, type Lang } from '../lib/i18n';
import { recapContent } from '../lib/recap';
import Icon from './Icon.astro';
import Photo from './Photo.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy(lang);
const { season, stats, cards, hasCalendar } = recapContent();
const nf = new Intl.NumberFormat(t.meta.locale);
const statList = [
  { n: stats.races, forms: t.recap.stats.races },
  { n: stats.raceDays, forms: t.recap.stats.raceDays },
  { n: stats.countries, forms: t.recap.stats.countries },
  { n: stats.uciRaces, forms: t.recap.stats.uciRaces },
].filter((s) => s.n > 0);
const hasContent = statList.length > 0 || cards.length > 0;
---

{
  hasContent && (
    <section class="section recap" id={anchor(lang, 'recap')} data-section="recap" aria-labelledby="recap-title">
      <div class="container">
        <div class="recap__head">
          <div class="section-head">
            <h2 id="recap-title">{fill(t.recap.title, { season }, lang)}</h2>
            <p class="lead recap__lead">{t.recap.lead}</p>
          </div>
          {hasCalendar && (
            <a class="btn btn--secondary" href={`#${seasonAnchor(lang, season)}`} data-season-link={season}>
              {fill(t.recap.calendarLink, { season }, lang)} <Icon name="arrow" size={18} />
            </a>
          )}
        </div>

        {statList.length > 0 && (
          <ul class="stats" role="list">
            {statList.map((s) => (
              <li class="stat">
                <span class="stat__n">{nf.format(s.n)}</span>
                <span class="stat__label">{plural(s.forms, s.n, lang)}</span>
              </li>
            ))}
          </ul>
        )}

        {cards.length > 0 && (
          <ul class="highlights" role="list">
            {cards.map((h) => (
              <li class="highlight card">
                <Photo
                  lang={lang}
                  dir="photos"
                  file={h.photo}
                  alt={pick(lang, h.alt)}
                  aspect="4:3"
                  sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
                />
                <div class="highlight__body">
                  <h3 class="highlight__title">{pick(lang, h.title)}</h3>
                  <p>{pick(lang, h.text)}</p>
                </div>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}

<style>
  .recap__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--s-4);
    margin-bottom: var(--s-6);
  }
  .recap__head .section-head {
    margin-bottom: 0;
  }
  .recap__lead {
    color: var(--ink);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-4);
  }
  .stat {
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }
  .stat__n {
    font-size: clamp(56px, 7vw, 96px);
    line-height: 1;
    letter-spacing: -0.03em;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 6px;
    text-underline-offset: 10px;
  }
  .stat__label {
    color: var(--ink-muted);
    font-size: var(--fs-body-lg);
  }
  .highlights {
    display: grid;
    gap: var(--s-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    margin-top: var(--s-6);
  }
  .highlight {
    overflow: hidden;
    background: var(--surface-alt);
  }
  .highlight__body {
    display: grid;
    gap: var(--s-2);
    padding: var(--s-4);
  }
  .highlight__title {
    font-size: 22px;
    line-height: 1.3;
    font-weight: 700;
  }
  .highlight p {
    color: var(--ink-muted);
    font-size: var(--fs-body-sm);
  }
  @media (max-width: 767px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: var(--s-5);
    }
  }
</style>
