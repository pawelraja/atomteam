---
// Results chapter (plum): national titles and national-championship medals counted from
// results/<year>.json, verified highlights, and the full results table. Hidden entirely until
// at least one result has been checked by the team ("verify" removed).
import { anchor } from '../lib/anchors';
import { copy, fill, pick, plural, type Lang } from '../lib/i18n';
import { resultsView } from '../lib/view';
import Photo from './Photo.astro';
import ResultsTable from './ResultsTable.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy(lang);
const tr = t.results;
const view = resultsView();
---

{
  view && (
    <section class="section results" data-theme="dark" id={anchor(lang, 'results')} data-section="results" aria-labelledby="results-title">
      <div class="container">
        <div class="results__grid">
          <div class="results__intro">
            <div class="chapter-head">
              <p class="eyebrow">{fill(tr.eyebrow, { season: view.season }, lang)}</p>
              <h2 id="results-title" class="chapter">{tr.title}</h2>
            </div>
            <dl class="figures">
              <div>
                <dt>{plural(tr.titles, view.figures.titles, lang)}</dt>
                <dd class="big-number">{view.figures.titles}</dd>
              </div>
              <div>
                <dt>{plural(tr.medals, view.figures.medals, lang)}</dt>
                <dd class="big-number">{view.figures.medals}</dd>
              </div>
            </dl>
            <p class="caption muted">{tr.figuresNote}</p>
          </div>
          <div class="results__table">
            <ResultsTable lang={lang} rows={view.rows} caption={fill(tr.tableCaption, { season: view.season }, lang)} />
          </div>
        </div>

        {view.highlights.length > 0 && (
          <ul class="highlights" role="list">
            {view.highlights.map((h) => (
              <li class="highlight">
                <Photo lang={lang} dir="photos" file={h.photo} alt={pick(lang, h.alt)} aspect="4:3" sizes="(min-width: 900px) 400px, 100vw" class="highlight__photo" />
                <h3 class="highlight__title">{pick(lang, h.title)}</h3>
                <p class="muted">{pick(lang, h.text)}</p>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}

<style>
  .results__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-6);
    align-items: start;
  }
  .figures {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-4);
    margin-bottom: var(--s-3);
  }
  .figures div {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding-top: var(--s-3);
    border-top: 2px solid var(--accent);
  }
  .figures dd {
    order: -1;
    color: var(--accent);
  }
  .figures dt {
    font-weight: 700;
  }
  .highlights {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-4);
    margin-top: var(--s-6);
  }
  .highlight {
    display: grid;
    align-content: start;
    gap: var(--s-2);
  }
  .highlight :global(.highlight__photo) {
    border-radius: var(--r-card);
    margin-bottom: var(--s-2);
  }
  .highlight__title {
    font-size: var(--fs-body-lg);
    line-height: 1.3;
  }
  @media (max-width: 999px) {
    .results__grid,
    .highlights {
      grid-template-columns: 1fr;
    }
  }
</style>
