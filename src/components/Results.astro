---
// Results chapter (plum): Polish national titles and national-championship medals counted from
// results/<year>.json with the workbook's rules, and the rows marked "featured". Rows stay
// "verify": true until the team signs them off; each carries a source link.
import { anchor, seasonAnchor } from '../lib/anchors';
import { copy, fill, plural, type Lang } from '../lib/i18n';
import { route } from '../lib/routes';
import { resultsView } from '../lib/view';
import Icon from './Icon.astro';
import ResultsTable from './ResultsTable.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy(lang);
const tr = t.results;
const view = resultsView();
---

{
  view && (
    <section class="results" data-theme="dark" id={anchor(lang, 'results')} data-section="results" aria-labelledby="results-title">
      <div class="container results__grid">
        <div class="results__intro">
          <p class="eyebrow">{tr.eyebrow}</p>
          <h2 id="results-title" class="chapter">{fill(tr.title, { season: view.season }, lang)}</h2>
          <p class="results__lead">{tr.lead}</p>
          <dl class="honours">
            <div>
              <dt>
                {plural(tr.titles, view.honours.titles, lang)}
                <span class="honours__note">{tr.titlesNote}</span>
              </dt>
              <dd>{view.honours.titles}</dd>
            </div>
            <div>
              <dt>
                {plural(tr.medals, view.honours.medals, lang)}
                <span class="honours__note">{tr.medalsNote}</span>
              </dt>
              <dd>{view.honours.medals}</dd>
            </div>
          </dl>
          <a class="results__archive" href={`${route(lang, 'calendar')}#${seasonAnchor(lang, view.season)}`}>
            {fill(tr.archive, { season: view.season }, lang)}
            <Icon name="arrow" size={16} />
          </a>
        </div>
        {view.featured.length > 0 && (
          <div class="results__table">
            <ResultsTable lang={lang} rows={view.featured} events={view.events} season={view.season} caption={fill(tr.tableCaption, { season: view.season }, lang)} />
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .results {
    padding-block: 120px;
    background: var(--surface);
    color: var(--ink);
  }
  .results__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--grid-gap);
  }
  .results__intro {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .results__table {
    grid-column: 6 / span 7;
  }
  .results__lead {
    font-size: 17px;
    line-height: 1.47;
    color: var(--ink-muted);
  }
  .honours {
    display: flex;
    gap: 40px;
    margin-top: 16px;
  }
  .honours div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .honours dd {
    order: -1;
    font-size: 72px;
    line-height: 1;
    letter-spacing: var(--ls-number);
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }
  .honours dt {
    font-size: 14px;
    line-height: 1.36;
    color: var(--ink-muted);
  }
  .honours__note {
    display: block;
  }
  .results__archive {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    align-self: flex-start;
    min-height: 44px;
    margin-top: 16px;
    color: var(--accent);
  }
  @media (max-width: 1023px) {
    .results__intro,
    .results__table {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 699px) {
    .results {
      padding-block: 64px;
    }
    .honours dd {
      font-size: 56px;
    }
  }
</style>
