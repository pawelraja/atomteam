---
// Four big figures, all counted at build time: riders (riders.json), races on the calendar
// (calendar/<year>.json), countries and disciplines raced (results/<year>.json).
import { anchor } from '../lib/anchors';
import { copy, fill, plural, type Lang } from '../lib/i18n';
import { listJoin } from '../lib/showcase';
import { numbersView } from '../lib/view';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy(lang);
const tn = t.numbers;
const view = numbersView();

const figures =
  view &&
  [
    {
      n: view.riders.total,
      label: plural(tn.riders, view.riders.total, lang, { season: view.season }),
      sub: fill(tn.split, { u19: view.riders.U19, u23: view.riders.U23, elite: view.riders.Elite }, lang),
    },
    { n: view.races, label: plural(tn.races, view.races, lang, { season: view.season }), sub: null },
    { n: view.countries, label: plural(tn.countries, view.countries, lang, { season: view.season }), sub: tn.countriesNote },
    {
      n: view.disciplines.length,
      label: plural(tn.disciplines, view.disciplines.length, lang),
      sub: listJoin(view.disciplines.map((d) => tn.disciplineNames[d]), t.meta.locale),
    },
  ];
---

{
  view && figures && (
    <section class="numbers" id={anchor(lang, 'numbers')} data-section="numbers" aria-label={fill(tn.label, { season: view.season }, lang)}>
      <dl class="container figures">
        {figures.map((f) => (
          <div class="figure">
            <dt class="figure__label">
              {f.label}
              {f.sub && <span class="figure__sub"> {f.sub}</span>}
            </dt>
            <dd class="figure__n">{f.n}</dd>
          </div>
        ))}
      </dl>
    </section>
  )
}

<style>
  .numbers {
    padding: 88px 0 96px;
    border-bottom: 1px solid #e4e0e6;
  }
  .figures {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
  }
  /* The number reads first visually; screen readers hear the label (dt) first. */
  .figure {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .figure__n {
    order: -1;
    font-size: var(--fs-number);
    line-height: 1;
    letter-spacing: var(--ls-number);
    font-variant-numeric: tabular-nums;
  }
  .figure__label {
    font-size: 15px;
    line-height: 1.4;
    color: var(--ink-muted);
  }
  .figure__sub {
    display: block;
  }
  @media (max-width: 899px) {
    .numbers {
      padding: 48px 0;
    }
    .figures {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 20px;
    }
    .figure__n {
      font-size: 56px;
    }
    .figure__label {
      font-size: 14px;
    }
  }
</style>
