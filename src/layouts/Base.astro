---
// Inter 400/700 (the Google Fonts typeface), self-hosted with font-display: swap: no third-party
// connection before first paint. latin-ext carries the Polish characters.
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-ext-400.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/inter/latin-ext-700.css';
import interLatin from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import '../styles/global.css';
import { getData } from '../lib/data';
import { HERO_DESKTOP_MEDIA, HERO_MOBILE_MEDIA, heroSources } from '../lib/hero';
import { copy, DEFAULT_LANG, fill, homePath, LANGS, type Lang } from '../lib/i18n';
import { graph, type Node } from '../lib/jsonld';
import { baseNodes, fullTeamNodes } from '../lib/pageld';
import { FEEDS } from '../lib/feed';
import { MARKDOWN } from '../lib/markdown';
import { PAGES, ROUTES } from '../lib/routes';

interface Props {
  lang: Lang;
  /** This page's address in each language (for canonical + hreflang). Defaults to the home page. */
  paths?: Record<Lang, string>;
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Preload the hero photo (home page only). */
  preloadHero?: boolean;
  /** Page-specific structured-data nodes (Person, SportsEvent, BreadcrumbList…). */
  jsonLd?: Node[];
  /** Emit the full SportsTeam (roster, coaches, sponsors) instead of the short team node. */
  fullTeam?: boolean;
  /** The 404 page: no canonical or hreflang (it has no address of its own), never indexed. */
  notFound?: boolean;
}
const { lang, preloadHero = false, fullTeam = false, notFound = false } = Astro.props;
const noindex = notFound || (Astro.props.noindex ?? false);
const paths = Astro.props.paths ?? { pl: homePath('pl'), en: homePath('en') };
const { site, today, todayOverridden } = getData();
const t = copy(lang);
const season = site.currentSeason;
const title = Astro.props.title ?? fill(t.meta.title, { season }, lang);
const description = Astro.props.description ?? fill(t.meta.description, { season, founded: site.foundedYear }, lang);
const abs = (p: string) => new URL(p, Astro.site).href;
const canonical = abs(paths[lang]);
const ogImage = abs(`/og-${lang}.png`);
const { desktop, mobile } = preloadHero ? await heroSources() : { desktop: null, mobile: null };

// Structured data: every page has the website and the team; pages add their own nodes
// (rider → Person, race → SportsEvent, calendar → upcoming races). Home and partners carry the full team.
const nodes = fullTeam ? [baseNodes(lang)[0], ...fullTeamNodes(lang)] : baseNodes(lang);
// Plain-text versions for agents: the Markdown page (where one exists) and the results feed.
const pageKey = PAGES.find((k) => ROUTES[k][lang] === paths[lang]);
const markdown = pageKey ? MARKDOWN[pageKey]?.[lang] : undefined;
const jsonLd = graph([...nodes, ...(Astro.props.jsonLd ?? [])]);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      !notFound && (
        <>
          <link rel="canonical" href={canonical} />
          {LANGS.map((l) => <link rel="alternate" hreflang={l} href={abs(paths[l])} />)}
          <link rel="alternate" hreflang="x-default" href={abs(paths[DEFAULT_LANG])} />
        </>
      )
    }
    <meta name="theme-color" content="#2b0020" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    <link rel="alternate" type="application/rss+xml" title={fill(t.markdown.feedTitle, {})} href={FEEDS[lang]} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.team.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!notFound && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fill(t.meta.ogAlt, { season }, lang)} />
    <meta property="og:locale" content={t.meta.ogLocale} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={copy(l).meta.ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />

    {mobile && <link rel="preload" as="image" imagesrcset={mobile.srcset} imagesizes="100vw" media={HERO_MOBILE_MEDIA} type="image/webp" fetchpriority="high" />}
    {desktop && <link rel="preload" as="image" imagesrcset={desktop.srcset} imagesizes="100vw" media={HERO_DESKTOP_MEDIA} type="image/webp" fetchpriority="high" />}

    <link rel="preload" as="font" type="font/woff2" href={interLatin} crossorigin />

    {!noindex && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body data-today={todayOverridden ? today : undefined} data-lang={lang}>
    <a class="skip-link" href="#main">{t.a11y.skip}</a>
    <slot />
  </body>
</html>
