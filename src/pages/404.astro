---
// 404 for every missing address (Vercel serves 404.html). One page for both languages, since a
// missing address can't say which language it was in; links lead back to the main pages.
import PageIntro from '../components/PageIntro.astro';
import Shell from '../components/Shell.astro';
import { copy, LANGS } from '../lib/i18n';
import { route, ROUTES } from '../lib/routes';

const pl = copy('pl');
const pages = ['home', 'team', 'calendar', 'faq', 'media'] as const;
const label = (l: (typeof LANGS)[number], k: (typeof pages)[number]) => {
  const t = copy(l);
  return k === 'faq' ? t.faq.title.replace(/\.$/, '') : k === 'media' ? t.nav.media : t.nav[k];
};
---

<Shell lang="pl" page="home" paths={ROUTES.home} title={`${pl.notFound.title} — ${pl.team.name}`} description={pl.notFound.lead} noindex>
  <PageIntro lang="pl" eyebrow={pl.notFound.eyebrow} title={pl.notFound.title} />
  <section class="section">
    <div class="container nf">
      {
        LANGS.map((l) => (
          <div lang={l}>
            {l !== 'pl' && <h2 class="h3">{copy(l).notFound.title}</h2>}
            <p class="body-lg">{copy(l).notFound.lead}</p>
            <ul class="nf__links" role="list">
              {pages.map((k) => (
                <li>
                  <a class="text-link" href={route(l, k)}>{label(l, k)}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</Shell>

<style>
  .nf {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px;
  }
  .nf > div {
    display: grid;
    align-content: start;
    gap: 12px;
  }
  .nf__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    padding: 0;
  }
  @media (max-width: 699px) {
    .nf {
      grid-template-columns: 1fr;
    }
  }
</style>
