---
// Home page. Pictures first: full-screen hero, the race-day gallery right after the numbers, a
// full-width photo break and the photo strip. Evergreen: seasonal facts live only in the status
// bar and in computed numbers. No content for prospective partners (partnerships are offline).
import Approach from '../components/Approach.astro';
import CalendarTeaser from '../components/CalendarTeaser.astro';
import Hero from '../components/Hero.astro';
import MediaTeaser from '../components/MediaTeaser.astro';
import Numbers from '../components/Numbers.astro';
import PartnerWall from '../components/PartnerWall.astro';
import PhotoBand from '../components/PhotoBand.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import Results from '../components/Results.astro';
import Shell from '../components/Shell.astro';
import Story from '../components/Story.astro';
import Team from '../components/Team.astro';
import type { Lang } from '../lib/i18n';
import { upcomingEventNodes } from '../lib/pageld';
import { ROUTES } from '../lib/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Shell lang={lang} page="home" paths={ROUTES.home} preloadHero fullTeam jsonLd={upcomingEventNodes(lang)}>
  <Hero lang={lang} />
  <Numbers lang={lang} />
  <Story lang={lang} />
  <Approach lang={lang} />
  <PhotoBand lang={lang} />
  <Results lang={lang} />
  <Team lang={lang} />
  <CalendarTeaser lang={lang} />
  <PartnerWall lang={lang} />
  <MediaTeaser lang={lang} />
  <PhotoStrip lang={lang} />
</Shell>
