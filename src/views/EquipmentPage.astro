---
// /sprzet and /en/equipment: what the team races on. Answer-first (the question is the heading,
// the answer the lead), then the wheel partner featured, then the full setup by partner.
// Unconfirmed items appear only in team preview builds, marked "to be confirmed".
import Icon from '../components/Icon.astro';
import PageIntro from '../components/PageIntro.astro';
import PartnerLogo from '../components/PartnerLogo.astro';
import Shell from '../components/Shell.astro';
import { getData } from '../lib/data';
import { visible, wheelMentionsOn, wheelPodiums, wheelProducts } from '../lib/equipment';
import { factVars } from '../lib/facts';
import { copy, fill, homePath, pick, plural, type Lang } from '../lib/i18n';
import { breadcrumbs, partnerNode } from '../lib/jsonld';
import { partnerLogoExists } from '../lib/images';
import { ctxFor } from '../lib/pageld';
import { route, ROUTES } from '../lib/routes';
import { TEAM } from '../lib/team';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { equipment, partners } = getData();
const t = copy(lang);
const te = t.equipment;
const w = equipment.wheels;
const partner = partners.find((p) => p.name === w.partner)!;
const vars = { ...factVars(lang), wheels: partner.name };
const latestSeason = Math.max(...w.seasons);
const stats = wheelPodiums(latestSeason);
const lead =
  wheelMentionsOn() && stats.podiums > 0
    ? fill(te.leadStats, { ...vars, wheelSeason: stats.season, wheelPodiums: plural(te.counts.podiums, stats.podiums, lang), wheelRaces: plural(te.counts.racesIn, stats.races, lang) }, lang)
    : fill(te.lead, vars, lang);
const facts = visible(w.facts);
const models = visible(w.models);
const quotes = visible(w.quotes);
const setup = visible(equipment.setup).map((s) => ({ ...s, info: partners.find((p) => p.name === s.partner)! }));
const disciplines = t.calendar.discipline;
const abs = (p: string) => new URL(p, TEAM.website).href;
// Only what this page is about: the wheel partner and its confirmed models (the full team lives on home).
const jsonLd = [
  partnerNode(ctxFor(lang), partner, fill(t.partners.about, { tier: t.partners.tierSingular[partner.tier] }, lang), partnerLogoExists(partner.logo) ? abs(`/partners/${partner.logo}`) : null),
  ...wheelProducts(ctxFor(lang)),
  breadcrumbs([
    { name: t.nav.home, url: abs(homePath(lang)) },
    { name: te.eyebrow, url: abs(route(lang, 'equipment')) },
  ]),
];
---

<Shell
  lang={lang}
  page="equipment"
  paths={ROUTES.equipment}
  title={fill(t.meta.pages.equipment.title, vars)}
  description={fill(t.meta.pages.equipment.description, vars, lang)}
  jsonLd={jsonLd}
>
  <PageIntro lang={lang} eyebrow={te.eyebrow} title={fill(te.title, vars, lang)} lead={lead} />

  <section class="section section--alt wheels" id="wheels" aria-labelledby="wheels-title">
    <div class="container wheels__grid">
      <div class="wheels__logo">
        <PartnerLogo lang={lang} name={partner.name} url={partner.url} logo={partner.logo} size="xl" />
      </div>
      <div class="wheels__body">
        <p class="eyebrow">{te.partnerEyebrow}</p>
        <h2 id="wheels-title" class="chapter">{partner.name}.</h2>
        <p class="wheels__about">{pick(lang, w.about)}</p>
        <dl class="facts">
          {
            facts.map((f) => (
              <div>
                <dt>{pick(lang, f.label)}</dt>
                <dd>
                  {pick(lang, f.value)}
                  {f.verify && <span class="chip verify">[VERIFY] {te.verify}</span>}
                </dd>
              </div>
            ))
          }
        </dl>
        <p>
          <a class="text-link" href={partner.url} target="_blank" rel="noopener sponsored">
            {fill(te.visit, vars)} <Icon name="arrow" size={16} />
            <span class="visually-hidden"> {t.a11y.newTab}</span>
          </a>
        </p>
      </div>

      {
        models.length > 0 && (
          <div class="wheels__wide">
            <h3 class="h3">{te.modelsTitle}</h3>
            <table class="models">
              <caption class="visually-hidden">{fill(te.modelsCaption, vars)}</caption>
              <thead>
                <tr>
                  <th scope="col">{te.model}</th>
                  <th scope="col">{te.discipline}</th>
                  <th scope="col">{te.rimDepth}</th>
                  <th scope="col">{te.use}</th>
                </tr>
              </thead>
              <tbody>
                {models.map((m) => (
                  <tr>
                    <th scope="row">
                      {m.url ? <a href={m.url} target="_blank" rel="noopener">{m.name}</a> : m.name}
                      {m.verify && <span class="chip verify">{te.verify}</span>}
                    </th>
                    <td>{disciplines[m.discipline]}</td>
                    <td>{m.rimDepth ? fill(te.mm, { n: m.rimDepth }) : '–'}</td>
                    <td>{pick(lang, m.use)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }

      {
        quotes.length > 0 && (
          <div class="wheels__wide">
            <h3 class="h3">{fill(te.quotesTitle, vars)}</h3>
            <ul class="quotes" role="list">
              {quotes.map((q) => (
                <li>
                  <figure>
                    <blockquote>
                      <p>{pick(lang, q.text)}</p>
                    </blockquote>
                    <figcaption>
                      {q.rider ?? fill(te.quoteAnon, vars)}
                      {q.verify && <span class="chip verify">{te.verify}</span>}
                    </figcaption>
                  </figure>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <section class="section setup" id="setup" aria-labelledby="setup-title">
    <div class="container">
      <div class="chapter-head">
        <h2 id="setup-title" class="chapter">{te.setupTitle}</h2>
        <p>{te.setupLead}</p>
      </div>
      <ul class="setup__grid" role="list">
        {
          setup.map((s) => (
            <li class="setup__item">
              <p class="setup__cat">{te.categories[s.category]}</p>
              <p class="setup__brand">
                <a href={s.info.url} target="_blank" rel="noopener sponsored">
                  {s.info.name}
                  <span class="visually-hidden"> {t.a11y.newTab}</span>
                </a>
              </p>
              {s.verify && <span class="chip verify">[VERIFY] {te.verify}</span>}
            </li>
          ))
        }
      </ul>
      <p class="setup__partners">{fill(te.partnersLead, vars, lang)}</p>
      <p>
        <a class="text-link" href={route(lang, 'partners')}>
          {te.partnersLink} <Icon name="arrow" size={16} />
        </a>
      </p>
    </div>
  </section>
</Shell>

<style>
  .wheels__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 48px var(--grid-gap);
    align-items: start;
  }
  .wheels__logo {
    grid-column: span 4;
  }
  .wheels__body {
    grid-column: 6 / span 7;
    display: grid;
    gap: 20px;
  }
  .wheels__wide {
    grid-column: 1 / -1;
    display: grid;
    gap: 20px;
  }
  .wheels__about {
    font-size: var(--fs-body-lg);
    max-width: 60ch;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 32px;
  }
  .facts div {
    display: grid;
    gap: 2px;
    padding: 14px 0;
    border-top: 1px solid #d9d2dc;
  }
  .facts dt {
    font-size: 13px;
    color: var(--ink-muted);
  }
  .facts dd {
    font-size: 17px;
  }
  .verify {
    margin-left: 8px;
    vertical-align: middle;
  }
  .models {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }
  .models thead th {
    padding: 12px 16px 12px 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .models tbody th,
  .models tbody td {
    padding: 16px 16px 16px 0;
    border-bottom: 1px solid var(--surface);
    text-align: left;
    font-weight: 400;
  }
  .quotes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    padding: 0;
  }
  .quotes blockquote p {
    font-size: 22px;
    line-height: 1.4;
  }
  .quotes figcaption {
    margin-top: 12px;
    font-size: 15px;
    color: var(--ink-muted);
  }
  .setup__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 24px;
    padding: 0;
    margin-bottom: 32px;
  }
  .setup__item {
    display: grid;
    align-content: start;
    gap: 4px;
    padding: 20px 0;
    border-top: 1px solid var(--line);
  }
  .setup__cat {
    font-size: 13px;
    color: var(--ink-muted);
  }
  .setup__brand {
    font-size: 20px;
  }
  .setup__brand a {
    color: inherit;
    text-decoration: none;
  }
  .setup__brand a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
  .setup__partners {
    font-size: 17px;
    color: var(--ink-muted);
    max-width: 70ch;
  }
  @media (max-width: 899px) {
    .wheels__logo,
    .wheels__body {
      grid-column: 1 / -1;
    }
    .setup__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .quotes {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 479px) {
    .facts {
      grid-template-columns: 1fr;
    }
    .models thead th:nth-child(4),
    .models tbody td:nth-child(4) {
      display: none;
    }
  }
</style>
