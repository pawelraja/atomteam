---
// /dane and /en/developers: the public data files, calendar feeds and text versions, documented
// for developers and AI agents, with Dataset structured data for each JSON file.
import PageIntro from '../components/PageIntro.astro';
import Shell from '../components/Shell.astro';
import { getData } from '../lib/data';
import { FEEDS } from '../lib/feed';
import { copy, fill, homePath, type Lang } from '../lib/i18n';
import { breadcrumbs, ids, type Node } from '../lib/jsonld';
import { lastmod } from '../lib/lastmod';
import { MARKDOWN } from '../lib/markdown';
import { DATA_FILES, dataFile, type DataFile } from '../lib/opendata';
import { ctxFor } from '../lib/pageld';
import { route, ROUTES } from '../lib/routes';
import { TEAM } from '../lib/team';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { site } = getData();
const t = copy(lang);
const td = t.developers;
const abs = (p: string) => new URL(p, TEAM.website).href;
const pageUrl = abs(route(lang, 'developers'));
const files = Object.keys(DATA_FILES) as DataFile[];
const updated = (f: DataFile) => JSON.parse(dataFile(f)).updated as string;
const example = JSON.stringify(JSON.parse(dataFile('riders')).data[0], null, 2);
const md = MARKDOWN;

const groups = [
  { id: 'files', title: td.filesTitle, rows: files.map((f) => ({ path: DATA_FILES[f], text: td.files[f], updated: updated(f) })) },
  {
    id: 'calendar',
    title: td.calendarTitle,
    rows: [
      { path: '/races.ics', text: td.calendar.all, updated: lastmod('calendar') },
      { path: `/calendar-${site.currentSeason}.ics`, text: fill(td.calendar.season, { season: site.currentSeason }), updated: lastmod('calendar') },
      { path: '/ics/<season>/<id>.ics', text: td.calendar.race, updated: null, pattern: true },
    ],
  },
  {
    id: 'text',
    title: td.textTitle,
    rows: [
      { path: '/llms.txt', text: td.text.llms, updated: null },
      { path: '/llms-full.txt', text: td.text.llmsFull, updated: null },
      { path: md.team![lang], text: td.text.markdown, updated: null },
      { path: '/sitemap.xml', text: td.text.sitemap, updated: null },
      { path: FEEDS[lang], text: td.text.rss, updated: null },
    ],
  },
];

const ctx = ctxFor(lang);
const jsonLd: Node[] = [
  ...files.map((f) => ({
    '@type': 'Dataset',
    '@id': `${pageUrl}#${f}`,
    name: fill(td.names[f], {}),
    description: td.files[f],
    url: pageUrl,
    inLanguage: ['pl', 'en'],
    isAccessibleForFree: true,
    creator: { '@id': ids.team(ctx) },
    dateModified: updated(f),
    distribution: { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: abs(DATA_FILES[f]) },
  })),
  breadcrumbs([
    { name: t.nav.home, url: abs(homePath(lang)) },
    { name: td.eyebrow, url: pageUrl },
  ]),
];
---

<Shell lang={lang} page="developers" paths={ROUTES.developers} title={t.meta.pages.developers.title} description={t.meta.pages.developers.description} jsonLd={jsonLd}>
  <PageIntro lang={lang} eyebrow={td.eyebrow} title={td.title} lead={td.lead} />

  {
    groups.map((g) => (
      <section class="section dev" id={g.id} aria-labelledby={`${g.id}-title`}>
        <div class="container">
          <h2 class="h3 dev__title" id={`${g.id}-title`}>{g.title}</h2>
          <table class="dev-table">
            <caption class="visually-hidden">{fill(td.tableCaption, { group: g.title })}</caption>
            <thead>
              <tr>
                <th scope="col">{td.path}</th>
                <th scope="col">{td.contents}</th>
                <th scope="col" class="col-updated">{td.updated}</th>
              </tr>
            </thead>
            <tbody>
              {g.rows.map((r) => (
                <tr>
                  <th scope="row">
                    <code>{'pattern' in r && r.pattern ? r.path : <a href={r.path}>{r.path}</a>}</code>
                  </th>
                  <td>{r.text}</td>
                  <td class="col-updated">{r.updated ?? '–'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))
  }

  <section class="section section--alt dev" aria-labelledby="rules-title">
    <div class="container dev__cols">
      <div>
        <h2 class="h3 dev__title" id="rules-title">{td.rulesTitle}</h2>
        <ul class="dev__rules">
          {td.rules.map((r) => <li>{fill(r, { website: abs(homePath(lang)) })}</li>)}
        </ul>
      </div>
      <div>
        <h2 class="h3 dev__title">{td.exampleTitle}</h2>
        <pre class="dev__code" tabindex="0"><code>{example}</code></pre>
      </div>
    </div>
  </section>
</Shell>

<style>
  .dev {
    padding-block: 56px;
  }
  .dev + .dev:not(.section--alt) {
    padding-top: 0;
  }
  .dev__title {
    margin-bottom: 16px;
  }
  .dev-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
    line-height: 1.45;
  }
  .dev-table thead th {
    padding: 12px 16px 12px 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .dev-table tbody th,
  .dev-table tbody td {
    padding: 14px 16px 14px 0;
    border-bottom: 1px solid var(--surface-alt);
    text-align: left;
    vertical-align: top;
    font-weight: 400;
  }
  .dev-table tbody th {
    width: 32%;
    word-break: break-all;
  }
  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 14px;
  }
  .col-updated {
    white-space: nowrap;
    color: var(--ink-muted);
  }
  .dev__cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px;
  }
  .dev__rules {
    display: grid;
    gap: 10px;
    padding-left: 20px;
    font-size: 16px;
    line-height: 1.5;
  }
  .dev__code {
    overflow-x: auto;
    max-width: 100%;
    padding: 20px;
    border-radius: var(--r-sm);
    background: var(--surface);
    font-size: 14px;
    line-height: 1.5;
  }
  @media (max-width: 899px) {
    .dev__cols {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 599px) {
    .col-updated {
      display: none;
    }
    .dev-table tbody th {
      width: 45%;
    }
  }
</style>
