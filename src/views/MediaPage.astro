---
// /media and /en/media: the media centre. No login, no forms: every file is a direct link with
// its format and size. "soon" items show a dashed state, never a broken link.
import { statSync } from 'node:fs';
import ContactCard from '../components/ContactCard.astro';
import PageIntro from '../components/PageIntro.astro';
import Photo from '../components/Photo.astro';
import Shell from '../components/Shell.astro';
import { anchor } from '../lib/anchors';
import { getData } from '../lib/data';
import { copy, fill, otherLang, pick, plural, typo, type Lang } from '../lib/i18n';
import { assertPressQuality, findOriginal } from '../lib/images';
import { DOWNLOADS, riderPath, ROUTES } from '../lib/routes';
import { MEDIA_CATEGORIES } from '../lib/schemas';
import { formatBytes, isContactComplete, riderSlug, rosterSplit, wordCount } from '../lib/showcase';
import { numbersView, officialRosterView, teamView } from '../lib/view';
import { MARKDOWN } from '../lib/markdown';
import { DATA_FILES } from '../lib/opendata';
import { TEAM } from '../lib/team';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { site, media } = getData();
const t = copy(lang);
const tm = t.mediaPage;
const other = otherLang(lang);
const a = (k: Parameters<typeof anchor>[1]) => anchor(lang, k);
const countries = t.calendar.countryNames as Record<string, string>;

/* Facts */
const roster = officialRosterView();
const split = rosterSplit(roster.items);
const rosterSeason = roster.season ?? site.currentSeason;
const disciplines = numbersView()?.disciplines ?? [];
const management = teamView()
  .crew.items.filter((s) => /dyrektor|menedżer/i.test(s.role.pl))
  .map((s) => `${s.name} (${pick(lang, s.role).toLocaleLowerCase(t.meta.locale)})`);
const sentenceCase = (s: string, locale: string) => s.charAt(0).toLocaleUpperCase(locale) + s.slice(1);
const riders = (l: Lang) => plural(copy(l).mediaPage.riderCount, split.total, l);
const facts = [
  { term: tm.facts.name, value: t.team.name },
  { term: tm.facts.licence, value: tm.facts.licenceValue },
  { term: tm.facts.founded, value: fill(tm.facts.foundedValue, { founded: site.foundedYear }, lang) },
  {
    term: fill(tm.facts.roster, { season: rosterSeason }, lang),
    value: fill(tm.facts.rosterValue, { riders: riders(lang), u19: split.U19, u23: split.U23, elite: split.Elite }, lang),
  },
  { term: tm.facts.management, value: management.join(', ') },
  { term: tm.facts.disciplines, value: sentenceCase(disciplines.map((d) => t.numbers.disciplineNames[d]).join(', '), t.meta.locale) },
  { term: tm.facts.programme, value: tm.facts.programmeValue },
];

/* Boilerplate in both languages, page language first */
const boilerplates = [lang, other].map((l) => {
  const text = fill(copy(l).mediaPage.boilerplateText, { founded: site.foundedYear, season: rosterSeason, riders: riders(l) }, l);
  return { lang: l, text, words: plural(tm.words, wordCount(text), lang) };
});

/* Files */
const files = media.files.map((f) => {
  const own = f.file[lang];
  const alt = f.file[other] && f.file[other]!.href !== own?.href ? f.file[other] : null;
  const name = pick(lang, f.name);
  return {
    ...f,
    name,
    description: pick(lang, f.description),
    own: own && { href: own.href, size: formatBytes(own.bytes, t.meta.locale) },
    alt: alt && { href: alt.href, size: formatBytes(alt.bytes, t.meta.locale) },
  };
});

/* Photo library: originals must be at least 3000 px on the long side (checked at build). */
const photos = media.photos.map((p) => {
  const original = assertPressQuality(p.file);
  const caption = pick(lang, p.caption);
  return {
    ...p,
    caption,
    download: original ? { href: DOWNLOADS.photo(original.name), size: formatBytes(statSync(original.path).size, t.meta.locale) } : null,
  };
});

/* Roster for journalists: switches to the new roster once rosterConfirmed is true. */
const rosterRows = roster.items.map((r) => {
  const original = findOriginal('riders', r.photo);
  return { r, portrait: original ? DOWNLOADS.portrait(original.name) : null };
});
/* Press photos as ImageObject structured data, with the photographer's credit (supplied photos only). */
const photoNodes = photos
  .filter((p) => p.download && !/^\[/.test(p.credit))
  .map((p) => ({
    '@type': 'ImageObject',
    contentUrl: new URL(p.download!.href, TEAM.website).href,
    caption: p.caption,
    creator: { '@type': 'Person', name: p.credit },
    creditText: fill(t.story.credit, { credit: p.credit }),
    copyrightNotice: p.credit,
  }));
const press = site.pressContact;
const responseTime = isContactComplete(press) && press?.responseTime ? pick(lang, press.responseTime) : null;
---

<Shell
  lang={lang}
  page="media"
  paths={ROUTES.media}
  fullTeam
  jsonLd={photoNodes}
  title={t.meta.pages.media.title}
  description={t.meta.pages.media.description}
>
  <PageIntro
    lang={lang}
    eyebrow={tm.eyebrow}
    title={tm.title}
    lead={tm.lead}
    navLabel={t.a11y.pageNav}
    nav={[
      { href: `#${a('facts')}`, label: tm.nav.facts },
      { href: `#${a('files')}`, label: tm.nav.files },
      { href: `#${a('photos')}`, label: tm.nav.photos },
      { href: `#${a('roster')}`, label: tm.nav.roster },
      { href: `#${a('contact')}`, label: tm.nav.press },
    ]}
  />

  <section class="mc-section" id={a('facts')} data-section="facts" aria-labelledby="facts-title">
    <div class="container facts-grid">
      <div class="facts-col">
        <h2 id="facts-title" class="h2">{tm.factsTitle}</h2>
        <dl class="facts">
          {
            facts.map((f) => (
              <>
                <dt>{f.term}</dt>
                <dd>{f.value}</dd>
              </>
            ))
          }
        </dl>
        <p class="facts-machine">
          {tm.machine} <a href={MARKDOWN.team![lang]}>{MARKDOWN.team![lang].slice(1)}</a> · <a href={DATA_FILES.team}>team.json</a> · <a href="/llms.txt">llms.txt</a>
        </p>
      </div>

      <div class="boiler-col" id={a('boilerplate')} data-section="boilerplate">
        <div class="boiler-head">
          <h2 class="h2" id="boiler-title">{tm.boilerplateTitle}</h2>
          <div class="chips" role="tablist" aria-label={tm.boilerplateLangs} data-tabs>
            {
              boilerplates.map((b, i) => (
                <button
                  type="button"
                  role="tab"
                  class="chip-btn"
                  id={`boiler-tab-${b.lang}`}
                  aria-controls={`boiler-${b.lang}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? 0 : -1}
                >
                  {b.lang.toUpperCase()}
                </button>
              ))
            }
          </div>
        </div>
        {
          boilerplates.map((b, i) => (
            <div class="boiler card" role="tabpanel" id={`boiler-${b.lang}`} aria-labelledby={`boiler-tab-${b.lang}`} hidden={i !== 0} tabindex="0">
              <p class="boiler__text" lang={b.lang} data-boiler-text>{b.lang === 'pl' ? typo('pl', b.text) : b.text}</p>
              <div class="boiler__foot">
                <span class="boiler__count">{b.words} · {tm.wordsNote}</span>
                <button type="button" class="btn btn--primary boiler__copy" data-copy>
                  {tm.copy}
                </button>
              </div>
              <p class="visually-hidden" role="status" aria-live="polite" data-copy-status />
            </div>
          ))
        }
        <script type="application/json" id="copy-labels" set:html={JSON.stringify({ copy: tm.copy, copied: tm.copied, fallback: tm.copyFallback })} />
      </div>
    </div>
  </section>

  <section class="mc-section mc-section--flush" id={a('files')} data-section="files" aria-labelledby="files-title">
    <div class="container stack">
      <h2 id="files-title" class="h2">{tm.filesTitle}</h2>
      <ul class="files" role="list">
        {
          files.map((f) => (
            <li class="file">
              <div class="file__text">
                <span class="file__name">{f.name}</span>
                <span class="file__desc">{f.description}</span>
              </div>
              <span class="file__format">{f.format}</span>
              <span class="file__size">{f.own ? f.own.size : '—'}</span>
              <span class="file__action">
                {f.own ? (
                  <>
                    <a class="btn btn--primary file__btn" href={f.own.href} download aria-label={fill(tm.downloadName, { name: f.name, format: f.format, size: f.own.size }, lang)}>
                      {tm.download}
                    </a>
                    {f.alt && (
                      <a class="file__alt" href={f.alt.href} download hreflang={other} aria-label={fill(tm.downloadName, { name: `${f.name} (${other.toUpperCase()})`, format: f.format, size: f.alt.size }, lang)}>
                        {other.toUpperCase()}
                      </a>
                    )}
                  </>
                ) : (
                  <span class="btn file__soon" aria-label={fill(tm.soonName, { name: f.name }, lang)}>
                    {tm.soon}
                  </span>
                )}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mc-section mc-section--alt" id={a('photos')} data-section="photos" aria-labelledby="photos-title" data-photo-library>
    <div class="container stack">
      <div class="photos-head">
        <div class="stack-s">
          <h2 id="photos-title" class="h2">{tm.photosTitle}</h2>
          <p class="muted">{tm.photosLead}</p>
        </div>
        <div class="chips" role="group" aria-label={tm.photoFiltersLabel}>
          {
            ['all', ...MEDIA_CATEGORIES].map((c) => (
              <button type="button" class="chip-btn" aria-pressed={c === 'all' ? 'true' : 'false'} data-photo-filter={c}>
                {tm.photoFilters[c as keyof typeof tm.photoFilters]}
              </button>
            ))
          }
        </div>
      </div>
      <ul class="photos" role="list">
        {
          photos.map((p) => (
            <li data-cat={p.category}>
              <figure class="photo-card">
                <div class="photo-card__img">
                  <Photo lang={lang} dir="media" file={p.file} alt={p.caption} aspect="4:3" sizes="(min-width: 1100px) 300px, (min-width: 700px) 45vw, 100vw" widths={[320, 480, 640, 960]} />
                  <span class="photo-card__cat">{tm.photoFilters[p.category]}</span>
                </div>
                <figcaption class="photo-card__cap">
                  <span class="photo-card__caption">{p.caption}</span>
                  <span class="photo-card__foot">
                    <span class="photo-card__credit">{fill(tm.credit, { credit: p.credit })}</span>
                    {p.download ? (
                      <a href={p.download.href} download aria-label={fill(tm.downloadJpgName, { caption: p.caption, size: p.download.size }, lang)}>
                        {tm.downloadJpg}
                      </a>
                    ) : (
                      <span class="photo-card__soon">{tm.photoSoon}</span>
                    )}
                  </span>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
      <p class="visually-hidden" role="status" aria-live="polite" data-photo-count />
    </div>
  </section>

  <section class="mc-section" id={a('roster')} data-section="roster" aria-labelledby="roster-title">
    <div class="container stack">
      <div class="roster-head">
        <h2 id="roster-title" class="h2">{fill(tm.rosterTitle, { season: rosterSeason }, lang)}</h2>
        {!site.rosterConfirmed && <p class="muted">{fill(tm.rosterNote, { next: site.currentSeason }, lang)}</p>}
      </div>
      <div class="table-wrap">
        <table class="roster">
          <caption class="visually-hidden">{fill(tm.rosterTable.caption, { season: rosterSeason }, lang)}</caption>
          <thead>
            <tr>
              <th scope="col">{tm.rosterTable.rider}</th>
              <th scope="col">{tm.rosterTable.nationality}</th>
              <th scope="col">{tm.rosterTable.squad}</th>
              <th scope="col">{tm.rosterTable.instagram}</th>
              <th scope="col">{tm.rosterTable.materials}</th>
            </tr>
          </thead>
          <tbody>
            {
              rosterRows.map(({ r, portrait }) => (
                <tr>
                  <th scope="row">
                    <a href={riderPath(lang, riderSlug(r))}>{r.name}</a>
                  </th>
                  <td>
                    <abbr title={countries[r.nat] ?? r.nat}>{r.nat}</abbr>
                  </td>
                  <td class="muted">{t.rider.squadShort[r.squad]}</td>
                  <td>
                    {r.instagram && (
                      <a href={`https://www.instagram.com/${r.instagram}/`} target="_blank" rel="noopener">
                        @{r.instagram}
                        <span class="visually-hidden"> {t.a11y.newTab}</span>
                      </a>
                    )}
                  </td>
                  <td class="materials">
                    <a href={riderPath(lang, riderSlug(r))} aria-label={`${tm.rosterTable.profile}: ${r.name}`}>
                      {tm.rosterTable.profile}
                    </a>
                    {' · '}
                    {portrait ? (
                      <a href={portrait} download aria-label={`${tm.rosterTable.portrait}: ${r.name}`}>
                        {tm.rosterTable.portrait}
                      </a>
                    ) : (
                      <span class="muted">{tm.rosterTable.portraitSoon}</span>
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="mc-section press" data-theme="dark" id={a('contact')} data-section="contact" aria-labelledby="press-title">
    <div class="container press__grid">
      <div class="press__intro">
        <h2 id="press-title" class="press__title">{tm.pressTitle}</h2>
        <p>
          {tm.pressLead}
          {responseTime && <> {fill(tm.responseTime, { time: responseTime }, lang)}</>}
        </p>
      </div>
      <ContactCard lang={lang} contact={press} label={tm.pressLabel} class="press__card" />
      <div class="press__rules">
        <h3 class="press__rules-title">{tm.rulesTitle}</h3>
        <ul role="list">
          {tm.rules.map((r) => <li>{r}</li>)}
        </ul>
      </div>
    </div>
  </section>
</Shell>

<script>
  import { initTabs } from '../components/Tabs';
  import { readJSON } from '../lib/client';
  import { plural } from '../lib/text';

  // Boilerplate language tabs.
  document.querySelectorAll<HTMLElement>('.boiler-head [data-tabs]').forEach((el) => initTabs(el));

  // "Copy text": clipboard first, falling back to selecting the text.
  const labels = readJSON<{ copy: string; copied: string; fallback: string }>('copy-labels');
  document.querySelectorAll<HTMLElement>('.boiler').forEach((panel) => {
    const button = panel.querySelector<HTMLButtonElement>('[data-copy]')!;
    const text = panel.querySelector<HTMLElement>('[data-boiler-text]')!;
    const status = panel.querySelector<HTMLElement>('[data-copy-status]')!;
    button.addEventListener('click', async () => {
      const plain = text.textContent!.replace(/ /g, ' ');
      try {
        await navigator.clipboard.writeText(plain);
        button.textContent = labels.copied;
        status.textContent = labels.copied;
      } catch {
        const range = document.createRange();
        range.selectNodeContents(text);
        const sel = getSelection()!;
        sel.removeAllRanges();
        sel.addRange(range);
        status.textContent = labels.fallback;
      }
      setTimeout(() => (button.textContent = labels.copy), 2500);
    });
  });

  // Photo filters (toggle buttons with aria-pressed); the count is announced.
  const library = document.querySelector<HTMLElement>('[data-photo-library]');
  if (library) {
    const buttons = [...library.querySelectorAll<HTMLButtonElement>('[data-photo-filter]')];
    const items = [...library.querySelectorAll<HTMLElement>('[data-cat]')];
    const count = library.querySelector<HTMLElement>('[data-photo-count]')!;
    const lang = document.documentElement.lang;
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const cat = b.dataset.photoFilter!;
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        let shown = 0;
        for (const item of items) {
          const on = cat === 'all' || item.dataset.cat === cat;
          item.hidden = !on;
          if (on) shown++;
        }
        count.textContent = plural(
          lang === 'pl' ? { one: '{n} zdjęcie', few: '{n} zdjęcia', many: '{n} zdjęć', other: '{n} zdjęcia' } : { one: '{n} photo', other: '{n} photos' },
          shown,
          lang as 'pl' | 'en',
        );
      }),
    );
  }
</script>

<style>
  .facts-machine {
    margin-top: 16px;
    font-size: 14px;
    color: var(--ink-muted);
  }
  .mc-section {
    padding-block: 104px;
  }
  .mc-section--flush {
    padding-top: 0;
  }
  .mc-section--alt {
    background: var(--surface-alt);
  }
  .stack {
    display: grid;
    gap: 32px;
  }
  .stack-s {
    display: grid;
    gap: 12px;
  }
  .h2 {
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip-btn {
    min-height: 36px;
    padding: 0 16px;
    border: 1px solid var(--accent);
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--accent-strong);
    font: 400 14px / 1 var(--font);
    cursor: pointer;
  }
  .chip-btn[aria-selected='true'],
  .chip-btn[aria-pressed='true'] {
    background: var(--accent);
    color: var(--ink-on-accent);
  }

  /* Facts + boilerplate */
  .facts-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--grid-gap);
  }
  .facts-col {
    grid-column: span 5;
    display: grid;
    align-content: start;
    gap: 24px;
  }
  .boiler-col {
    grid-column: 7 / span 6;
    display: grid;
    align-content: start;
    gap: 20px;
  }
  .facts {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    font-size: 15px;
    line-height: 1.4;
  }
  .facts dt,
  .facts dd {
    padding: 14px 0;
    border-top: 1px solid #e4e0e6;
  }
  .facts dt {
    color: var(--ink-muted);
    padding-right: 16px;
  }
  .facts dt:nth-last-of-type(1),
  .facts dd:nth-last-of-type(1) {
    border-bottom: 1px solid #e4e0e6;
  }
  .boiler-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
  }
  .boiler {
    display: grid;
    gap: 20px;
    padding: 32px;
    background: var(--surface-alt);
  }
  .boiler[hidden] {
    display: none;
  }
  .boiler__text {
    font-size: 18px;
    line-height: 1.55;
  }
  .boiler__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .boiler__count {
    font-size: 14px;
    color: var(--ink-muted);
  }
  .boiler__copy {
    min-height: 44px;
    font-size: 14px;
    font-weight: 400;
  }

  /* Files */
  .file {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px 140px 180px;
    gap: 24px;
    align-items: center;
    padding: 22px 0;
    border-top: 1px solid #e4e0e6;
  }
  .file__text {
    display: grid;
    gap: 4px;
  }
  .file__name {
    font-size: 20px;
    line-height: 28px;
  }
  .file__desc {
    font-size: 14px;
    color: var(--ink-muted);
  }
  .file__format {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--accent-strong);
  }
  .file__size {
    font-size: 14px;
    color: var(--ink-muted);
  }
  .file__action {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 12px;
  }
  .file__btn {
    min-height: 44px;
    font-size: 14px;
  }
  .file__soon {
    min-height: 44px;
    border: 1px dashed var(--ink-subtle);
    color: var(--ink-muted);
    font-size: 14px;
    font-weight: 400;
    cursor: default;
  }
  .file__alt {
    display: inline-grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    font-size: 14px;
    font-weight: 700;
  }

  /* Photo library */
  .photos-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px 32px;
    flex-wrap: wrap;
  }
  .photos-head .muted {
    font-size: 15px;
  }
  .photos {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }
  .photos li[hidden] {
    display: none;
  }
  .photo-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: var(--r-card);
    background: #ffffff;
  }
  .photo-card__img {
    position: relative;
  }
  .photo-card__img :global(.ph) {
    position: relative;
  }
  .photo-card__img :global(.ph__label) {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 12px;
    text-align: left;
    font-size: 11px;
  }
  .photo-card__img :global(.ph__file) {
    font-weight: 400;
  }
  .photo-card__cat {
    position: absolute;
    left: 14px;
    top: 12px;
    padding: 3px 9px;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.9);
    font-size: 11px;
    font-weight: 700;
    color: #2b0020;
  }
  .photo-card__cap {
    display: grid;
    gap: 10px;
    padding: 16px 18px 18px;
  }
  .photo-card__caption {
    font-size: 15px;
    line-height: 1.4;
  }
  .photo-card__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }
  .photo-card__credit {
    font-size: 12px;
    color: var(--ink-muted);
  }
  .photo-card__foot a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    font-size: 14px;
    font-weight: 700;
  }
  .photo-card__soon {
    padding: 2px 10px;
    border: 1px dashed var(--ink-subtle);
    border-radius: var(--r-pill);
    font-size: 12px;
    color: var(--ink-muted);
  }

  /* Roster table */
  .roster-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 32px;
