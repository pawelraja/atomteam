{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run sync-photos && npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/wyscigi", "destination": "/kalendarz/", "permanent": false },
    { "source": "/wyscigi/:season", "destination": "/kalendarz/", "permanent": false },
    { "source": "/en/races", "destination": "/en/calendar/", "permanent": false },
    { "source": "/en/races/:season", "destination": "/en/calendar/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.ics",
      "headers": [
        { "key": "Content-Type", "value": "text/calendar; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
