# Photos and logos come from Google Drive (npm run sync-photos), which overwrites files of the
# same name. Until the originals arrive, temporary low-resolution copies of photos, portraits and
# logos are committed (src/assets/photos, src/assets/riders, public/partners, public/brand).
# Press originals and downloads are never committed.
src/assets/media/*
!src/assets/media/.gitkeep
public/media/*
!public/media/.gitkeep
.vercel
