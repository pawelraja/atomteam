# URL that receives newsletter sign-ups as a POST with JSON { email, consent }.
# Leave empty until a newsletter provider is connected; the form will then show a friendly error.
NEWSLETTER_ENDPOINT=

# Google Drive photo sync (npm run sync-photos, runs before every Vercel build).
# The service account key: paste the whole JSON, or the JSON encoded as base64.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Id of the shared "MADW Website" folder: the part after /folders/ in its Drive URL.
DRIVE_FOLDER_ID=
