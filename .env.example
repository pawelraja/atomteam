# Newsletter: MailerLite embedded form. Both numbers are in the form's embed code
# (https://assets.mailerlite.com/jsonp/<account>/forms/<form>/subscribe); they are not secrets.
MAILERLITE_ACCOUNT_ID=
MAILERLITE_FORM_ID=
# Optional: key of a MailerLite custom field that should receive "pl" / "en".
MAILERLITE_LANGUAGE_FIELD=
# Alternative to MailerLite: any URL that accepts a POST with JSON { email, consent, lang }.
# With neither set, the form says sign-ups open soon and points to the team's e-mail.
NEWSLETTER_ENDPOINT=

# Google Drive photo sync (npm run sync-photos, runs before every Vercel build).
# The service account key: paste the whole JSON, or the JSON encoded as base64.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Id of the shared "MADW Website" folder: the part after /folders/ in its Drive URL.
DRIVE_FOLDER_ID=

# Search indexing. Automatic: a Vercel production build on the team's own domain is indexable,
# the temporary *.vercel.app address is not (src/lib/indexing.mjs). Set "on" or "off" to force it.
SITE_INDEXING=
# Ownership tags for Google Search Console and Bing Webmaster Tools (HTML-tag method, code only).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
